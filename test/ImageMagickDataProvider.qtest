        # Test with sigma parameter
        result = oilPaint.doRequest({
            "input_path": testImagePath,
            "radius": 3.0,
            "sigma": 2.0,
        });
        assertEq(100, result.width, "oil-paint with sigma preserves width");
        assertEq(80, result.height, "oil-paint with sigma preserves height");
        assertEq(True, result.data instanceof binary, "oil-paint with sigma returns data");
