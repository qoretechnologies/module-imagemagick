        addTestCase("Despeckle action tests", \despeckleActionTest());
        addTestCase("Reduce-noise action tests", \reduceNoiseActionTest());
        addTestCase("Wavelet-denoise action tests", \waveletDenoiseActionTest());

        # Transform tests
        addTestCase("Trim action tests", \trimActionTest());
        addTestCase("Border action tests", \borderActionTest());
        addTestCase("Frame action tests", \frameActionTest());
        addTestCase("Shear action tests", \shearActionTest());
        addTestCase("Deskew action tests", \deskewActionTest());

        # Phase 1: High-value image operations
        addTestCase("Scale action tests", \scaleActionTest());
        addTestCase("Resample action tests", \resampleActionTest());
        addTestCase("Extent action tests", \extentActionTest());
        addTestCase("Selective-blur action tests", \selectiveBlurActionTest());
        addTestCase("Liquid-rescale action tests", \liquidRescaleActionTest());

        # Phase 2: Geometry operations
        addTestCase("Adaptive-resize action tests", \adaptiveResizeActionTest());
