    # ==================== Phase 3: Metadata Actions ====================

    setResolutionActionTest() {
        AbstractDataProvider dp = getProvider("image/set-resolution");

        hash<auto> result = dp.doRequest({
            "input_path": testImagePath,
            "x": 300.0,
            "y": 300.0,
        });
        assertEq(100, result.width, "set-resolution preserves width");
        assertEq(80, result.height, "set-resolution preserves height");
        assertEq(True, result.data instanceof binary, "set-resolution returns binary data");
    }

    setDepthActionTest() {
        AbstractDataProvider dp = getProvider("image/set-depth");

        hash<auto> result = dp.doRequest({
            "input_path": testImagePath,
            "depth": 16,
        });
        assertEq(100, result.width, "set-depth preserves width");
        assertEq(80, result.height, "set-depth preserves height");
        assertEq(True, result.data instanceof binary, "set-depth returns binary data");
    }

    setPropertyActionTest() {
        AbstractDataProvider dp = getProvider("image/set-property");

        hash<auto> result = dp.doRequest({
            "input_path": testImagePath,
            "name": "comment",
            "value": "Test comment value",
        });
        assertEq(100, result.width, "set-property preserves width");
        assertEq(True, result.data instanceof binary, "set-property returns binary data");

        # Verify the property was set by reading it back
        AbstractDataProvider getPropsDp = getProvider("info/get-properties");
        hash<auto> propsResult = getPropsDp.doRequest({
            "data": result.data,
            "pattern": "comment",
        });
        assertEq("Test comment value", propsResult.properties.comment,
            "set-property value persists");
    }

    setProfileActionTest() {
        AbstractDataProvider dp = getProvider("image/set-profile");

        # Use iptc profile which is more tolerant of arbitrary data
        binary profileData = binary("test-profile-data");
        try {
            hash<auto> result = dp.doRequest({
                "input_path": testImagePath,
                "name": "iptc",
                "profile_data": profileData,
            });
            assertEq(100, result.width, "set-profile preserves width");
            assertEq(True, result.data instanceof binary, "set-profile returns binary data");

            # Verify the profile was set
            AbstractDataProvider getProfileDp = getProvider("info/get-profile");
            hash<auto> profileResult = getProfileDp.doRequest({
                "data": result.data,
                "name": "iptc",
            });
            assertEq("iptc", profileResult.name, "get-profile returns correct name");
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "IMAGEMAGICK-ERROR") {
                # Some IM builds reject arbitrary profile data; test that the action
                # is at least callable
                testSkip("set-profile rejected test data: " + ex.desc);
            }
            rethrow;
        }
    }

    getPropertiesActionTest() {
        AbstractDataProvider dp = getProvider("info/get-properties");

        # Test with default pattern (all properties)
        hash<auto> result = dp.doRequest({
            "input_path": testImagePath,
        });
        assertEq(True, result.properties instanceof hash, "get-properties returns hash");

        # Test with specific pattern
        result = dp.doRequest({
            "input_path": testImagePath,
            "pattern": "date:*",
        });
        assertEq(True, result.properties instanceof hash, "get-properties with pattern returns hash");
    }

    getExifActionTest() {
        AbstractDataProvider dp = getProvider("info/get-exif");

        # Synthetic PNG has no EXIF; test that it returns gracefully
        hash<auto> result = dp.doRequest({
            "input_path": testImagePath,
        });
        assertEq(True, result.properties instanceof hash, "get-exif returns hash");
    }

    getProfileActionTest() {
        AbstractDataProvider dp = getProvider("info/get-profile");

        # Synthetic PNG has no ICC profile; should return NOTHING for data
        hash<auto> result = dp.doRequest({
            "input_path": testImagePath,
            "name": "icc",
        });
        assertEq("icc", result.name, "get-profile returns profile name");
        # data may be NOTHING for images without the profile
    }

    # ==================== Phase 4: Drawing Action ====================

    drawActionTest() {
        AbstractDataProvider dp = getProvider("image/draw");

        # Test basic shapes: rectangle and line
        hash<auto> result = dp.doRequest({
            "input_path": testImagePath,
            "fill_color": "blue",
            "stroke_color": "black",
            "stroke_width": 2.0,
            "operations": (
                {"type": "rectangle", "x1": 10.0, "y1": 10.0, "x2": 50.0, "y2": 40.0},
                {"type": "line", "sx": 10.0, "sy": 10.0, "ex": 50.0, "ey": 40.0},
            ),
        });
        assertEq(100, result.width, "draw preserves width");
        assertEq(80, result.height, "draw preserves height");
        assertEq(True, result.data instanceof binary, "draw returns binary data");

        # Test circle and ellipse
        result = dp.doRequest({
            "input_path": testImagePath,
            "fill_color": "green",
            "operations": (
                {"type": "circle", "ox": 50.0, "oy": 40.0, "px": 70.0, "py": 40.0},
                {"type": "ellipse", "ox": 50.0, "oy": 40.0, "rx": 30.0, "ry": 20.0,
                    "start": 0.0, "end": 360.0},
            ),
        });
        assertEq(True, result.data instanceof binary, "draw circle/ellipse works");

        # Test text drawing
        result = dp.doRequest({
            "input_path": testImagePath,
            "fill_color": "white",
            "font_size": 12.0,
            "operations": (
                {"type": "text", "x": 10.0, "y": 50.0, "text": "Hello"},
            ),
        });
        assertEq(True, result.data instanceof binary, "draw text works");

        # Test point and polygon
        result = dp.doRequest({
            "input_path": testImagePath,
            "fill_color": "red",
            "operations": (
                {"type": "point", "x": 50.0, "y": 40.0},
                {"type": "polygon", "points": (
                    {"x": 10.0, "y": 10.0},
                    {"x": 90.0, "y": 10.0},
                    {"x": 50.0, "y": 70.0},
                )},
            ),
        });
        assertEq(True, result.data instanceof binary, "draw point/polygon works");

        # Test polyline
        result = dp.doRequest({
            "input_path": testImagePath,
            "stroke_color": "yellow",
            "stroke_width": 3.0,
            "operations": (
                {"type": "polyline", "points": (
                    {"x": 10.0, "y": 10.0},
                    {"x": 50.0, "y": 70.0},
                    {"x": 90.0, "y": 10.0},
                )},
            ),
        });
        assertEq(True, result.data instanceof binary, "draw polyline works");

        # Test rounded rectangle
        result = dp.doRequest({
            "input_path": testImagePath,
            "fill_color": "purple",
            "operations": (
                {"type": "round-rectangle", "x1": 10.0, "y1": 10.0, "x2": 90.0, "y2": 70.0,
                    "rx": 10.0, "ry": 10.0},
            ),
        });
        assertEq(True, result.data instanceof binary, "draw round-rectangle works");

        # Test arc
        result = dp.doRequest({
            "input_path": testImagePath,
            "stroke_color": "cyan",
            "operations": (
                {"type": "arc", "sx": 10.0, "sy": 10.0, "ex": 90.0, "ey": 70.0,
                    "sd": 0.0, "ed": 180.0},
            ),
        });
        assertEq(True, result.data instanceof binary, "draw arc works");

        # Test invalid operation type
        assertThrows("IMAGEMAGICK-DRAW-ERROR", \dp.doRequest(), ({
            "input_path": testImagePath,
            "operations": (
                {"type": "invalid-shape"},
            ),
        },));
    }

    # ==================== Action Catalog Validation Tests ====================

    actionCatalogValidationTest() {
        # Get all actions for the ImageMagick app
        list<hash<DataProviderActionInfo>> actions =
            DataProviderActionCatalog::getActions("ImageMagick");
        # Expected action count: 59 original + 5 phase 1 + 7 phase 2 + 7 phase 3 + 1 phase 4 = 79
        assertEq(79, actions.size(), "ImageMagick has 79 registered actions");

        # Verify each action has required fields
        foreach hash<DataProviderActionInfo> action in (actions) {
            assertEq(True, exists action.display_name && action.display_name.length() > 0,
                sprintf("action '%s' has display_name", action.action));
            assertEq(True, exists action.short_desc && action.short_desc.length() > 0,
                sprintf("action '%s' has short_desc", action.action));
            assertEq(True, exists action.desc && action.desc.length() > 0,
                sprintf("action '%s' has desc", action.action));
            assertEq(True, exists action.options,
                sprintf("action '%s' has options", action.action));
            assertEq(True, exists action.output_type,
                sprintf("action '%s' has output_type", action.action));
        }

        # Verify specific actions are present
        hash<string, bool> actionNames;
        foreach hash<DataProviderActionInfo> action in (actions) {
            actionNames{action.action} = True;
        }

        # Original actions
        list<string> expectedOriginal = (
            "resize", "crop", "rotate", "flip", "blur", "sharpen",
            "brightness-contrast", "composite", "annotate", "thumbnail",
            "auto-orient", "strip", "charcoal", "sepia", "oil-paint",
            "edge", "emboss", "convert-format", "get-info",
        );
        foreach string name in (expectedOriginal) {
            assertEq(True, actionNames{name} ?? False,
                sprintf("original action '%s' is registered", name));
        }

        # New color actions
        list<string> expectedColor = (
            "negate", "normalize", "equalize", "auto-gamma", "auto-level",
            "enhance", "white-balance", "gamma", "modulate", "level",
            "contrast-stretch", "linear-stretch", "sigmoidal-contrast",
            "transform-colorspace", "threshold",
        );
        foreach string name in (expectedColor) {
            assertEq(True, actionNames{name} ?? False,
                sprintf("color action '%s' is registered", name));
        }

        # New effects
        list<string> expectedEffects = (
            "solarize", "posterize", "vignette", "sketch", "wave", "swirl",
            "implode", "shadow", "shade", "add-noise", "blue-shift",
        );
        foreach string name in (expectedEffects) {
            assertEq(True, actionNames{name} ?? False,
                sprintf("effect action '%s' is registered", name));
        }

        # New blur/sharpen/denoise
        list<string> expectedBlur = (
            "gaussian-blur", "motion-blur", "adaptive-blur", "rotational-blur",
            "adaptive-sharpen", "unsharp-mask", "despeckle", "reduce-noise",
            "wavelet-denoise",
        );
        foreach string name in (expectedBlur) {
            assertEq(True, actionNames{name} ?? False,
                sprintf("blur/sharpen action '%s' is registered", name));
        }

        # New transforms
        list<string> expectedTransforms = (
            "trim", "border", "frame", "shear", "deskew",
        );
        foreach string name in (expectedTransforms) {
            assertEq(True, actionNames{name} ?? False,
                sprintf("transform action '%s' is registered", name));
        }

        # Phase 1: High-value operations
        list<string> expectedPhase1 = (
            "scale", "resample", "extent", "selective-blur", "liquid-rescale",
        );
        foreach string name in (expectedPhase1) {
            assertEq(True, actionNames{name} ?? False,
                sprintf("phase 1 action '%s' is registered", name));
        }

        # Phase 2: Geometry operations
        list<string> expectedPhase2 = (
            "adaptive-resize", "sample", "transpose", "transverse",
            "chop", "shave", "splice",
        );
        foreach string name in (expectedPhase2) {
            assertEq(True, actionNames{name} ?? False,
                sprintf("phase 2 action '%s' is registered", name));
        }

        # Phase 3: Metadata actions
        list<string> expectedPhase3 = (
            "set-resolution", "set-depth", "set-property", "set-profile",
            "get-properties", "get-exif", "get-profile",
        );
        foreach string name in (expectedPhase3) {
            assertEq(True, actionNames{name} ?? False,
                sprintf("phase 3 action '%s' is registered", name));
        }

        # Phase 4: Drawing action
        assertEq(True, actionNames{"draw"} ?? False, "draw action is registered");
    }

    # ==================== Negative Tests for New Actions ====================

    newActionNegativeTests() {
        # Test missing required input source
        AbstractDataProvider gamma = getProvider("image/color/gamma");
        assertThrows("REQUIRED-FIELD-GROUP-ERROR", \gamma.doRequest(), ({
            "gamma_value": 1.5,
        },));

        # Test nonexistent file
        AbstractDataProvider negate = getProvider("image/color/negate");
        assertThrows("IMAGEMAGICK-ERROR", \negate.doRequest(), ({
            "input_path": "/nonexistent/path.png",
        },));

        # Test add-noise with invalid noise type
        AbstractDataProvider addNoise = getProvider("image/effects/add-noise");
        assertThrows("RUNTIME-TYPE-ERROR", \addNoise.doRequest(), ({
            "input_path": testImagePath,
            "noise_type": "InvalidNoiseType",
        },));

        # Test transform-colorspace with invalid colorspace
        AbstractDataProvider colorspace = getProvider("image/color/transform-colorspace");
        assertThrows("RUNTIME-TYPE-ERROR", \colorspace.doRequest(), ({
            "input_path": testImagePath,
            "colorspace": "InvalidColorspace",
        },));
    }
}
