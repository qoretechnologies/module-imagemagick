    # ==================== Transform Tests ====================

    trimActionTest() {
        # Create an image with a border to trim
        MagickImage img(100, 80, "white");
        img.setFormat("PNG");
        # Draw a small red rectangle in the center to give trim something to work with
        binary imgdata = img.toData();

        AbstractDataProvider dp = getProvider("image/trim");

        hash<auto> result = dp.doRequest({
            "data": imgdata,
        });
        # Trim may change dimensions (removes uniform border)
        assertEq(True, result.width > 0, "trim returns positive width");
        assertEq(True, result.height > 0, "trim returns positive height");
        assertEq(True, result.data instanceof binary, "trim returns binary data");

        # Test with fuzz
        result = dp.doRequest({
            "input_path": testImagePath,
            "fuzz": 10.0,
        });
        assertEq(True, result.data instanceof binary, "trim with fuzz returns data");
    }

    borderActionTest() {
        AbstractDataProvider dp = getProvider("image/border");

        hash<auto> result = dp.doRequest({
            "input_path": testImagePath,
            "color": "blue",
            "width": 10,
            "height": 10,
        });
        # Border increases dimensions by 2*width and 2*height
        assertEq(120, result.width, "border increases width by 2*10");
        assertEq(100, result.height, "border increases height by 2*10");
        assertEq(True, result.data instanceof binary, "border returns binary data");
    }

    frameActionTest() {
        AbstractDataProvider dp = getProvider("image/frame");

        hash<auto> result = dp.doRequest({
            "input_path": testImagePath,
            "color": "gray",
            "width": 10,
            "height": 10,
            "inner_bevel": 3,
            "outer_bevel": 3,
        });
        # Frame increases dimensions
        assertEq(True, result.width > 100, "frame increases width");
        assertEq(True, result.height > 80, "frame increases height");
        assertEq(True, result.data instanceof binary, "frame returns binary data");
    }

    shearActionTest() {
        AbstractDataProvider dp = getProvider("image/shear");

        hash<auto> result = dp.doRequest({
            "input_path": testImagePath,
            "x": 10.0,
            "y": 0.0,
        });
        # Shear may change dimensions
        assertEq(True, result.width > 0, "shear returns positive width");
        assertEq(True, result.height > 0, "shear returns positive height");
        assertEq(True, result.data instanceof binary, "shear returns binary data");

        # Test with background
        result = dp.doRequest({
            "input_path": testImagePath,
            "x": 5.0,
            "y": 5.0,
            "background": "black",
        });
        assertEq(True, result.data instanceof binary, "shear with background returns data");
    }

    deskewActionTest() {
        AbstractDataProvider dp = getProvider("image/deskew");

        hash<auto> result = dp.doRequest({
            "input_path": testImagePath,
            "threshold": 40.0,
        });
