    # ==================== Edge Effect Tests ====================

    edgeActionTest() {
        AbstractDataProvider edge = getProvider("image/effects/edge");

        hash<auto> result = edge.doRequest({
            "input_path": testImagePath,
            "radius": 1.0,
        });
        assertEq(100, result.width, "edge preserves width");
        assertEq(80, result.height, "edge preserves height");
    }

    # ==================== Emboss Effect Tests ====================

    embossActionTest() {
        AbstractDataProvider emboss = getProvider("image/effects/emboss");

        hash<auto> result = emboss.doRequest({
            "input_path": testImagePath,
            "radius": 0.0,
            "sigma": 1.0,
        });
        assertEq(100, result.width, "emboss preserves width");
        assertEq(80, result.height, "emboss preserves height");

        # Test with defaults
        result = emboss.doRequest({
            "input_path": testImagePath,
        });
        assertEq(True, result.data instanceof binary, "emboss with defaults returns data");
    }

    # ==================== Convert Format Action Tests ====================

    convertFormatActionTest() {
        AbstractDataProvider fmt = getProvider("convert/format");

        # PNG to JPEG
        hash<auto> result = fmt.doRequest({
            "input_path": testImagePath,
            "format": "JPEG",
        });
        assertEq("JPEG", result.format, "convert to JPEG format");
        assertEq(100, result.width, "convert preserves width");
        assertEq(80, result.height, "convert preserves height");

        # PNG to JPEG with quality
        result = fmt.doRequest({
            "input_path": testImagePath,
            "format": "JPEG",
            "quality": 50,
        });
        assertEq("JPEG", result.format, "convert with quality");

        # PNG to GIF
        result = fmt.doRequest({
            "input_path": testImagePath,
            "format": "GIF",
        });
        assertEq("GIF", result.format, "convert to GIF");

        # PNG to BMP
        result = fmt.doRequest({
            "input_path": testImagePath,
            "format": "BMP",
        });
        assertEq("BMP", result.format, "convert to BMP");

        # PNG to TIFF
        result = fmt.doRequest({
            "input_path": testImagePath,
            "format": "TIFF",
        });
        assertEq("TIFF", result.format, "convert to TIFF");
    }

    # ==================== Get Info Action Tests ====================

    getInfoActionTest() {
        AbstractDataProvider info = getProvider("info/get");

        hash<auto> result = info.doRequest({
            "input_path": testImagePath,
        });
        assertEq(100, result.width, "get-info width");
        assertEq(80, result.height, "get-info height");
        assertEq("PNG", result.format, "get-info format");
        assertEq(True, result.depth > 0, "get-info depth is positive");
        assertEq(True, result.colorspace instanceof string, "get-info colorspace is string");
        assertEq(True, result.image_type instanceof string, "get-info image_type is string");
        assertEq(True, result.compression_quality >= 0, "get-info compression_quality non-negative");
        assertEq(True, result.number_images >= 1, "get-info number_images >= 1");
        assertEq(True, result.colors >= 1, "get-info colors >= 1");
        assertEq(True, result.signature instanceof string, "get-info signature is string");
        assertGt(0, result.signature.length(), "get-info signature is non-empty");
        assertEq(True, result.resolution instanceof hash, "get-info resolution is hash");
        assertEq(True, result.resolution.x instanceof float, "get-info resolution.x is float");
        assertEq(True, result.resolution.y instanceof float, "get-info resolution.y is float");

        # Test with binary data input
        binary imgdata = createTestImageData(200, 150, "blue");
        result = info.doRequest({
            "data": imgdata,
        });
        assertEq(200, result.width, "get-info binary width");
        assertEq(150, result.height, "get-info binary height");
    }

    # ==================== Binary Data Input Tests ====================

    binaryDataInputTest() {
        # Test all actions accept binary data input as well as file path
        binary imgdata = createTestImageData(60, 40, "green");

        # Resize with binary input
        AbstractDataProvider resize = getProvider("image/resize");
        hash<auto> result = resize.doRequest({
            "data": imgdata,
            "width": 30,
            "height": 20,
        });
        assertEq(30, result.width, "resize from binary data width");
        assertEq(20, result.height, "resize from binary data height");

        # Crop with binary input
        AbstractDataProvider crop = getProvider("image/crop");
        result = crop.doRequest({
            "data": imgdata,
            "width": 30,
            "height": 20,
            "x": 5,
            "y": 5,
        });
        assertEq(30, result.width, "crop from binary data width");

        # Convert with binary input
        AbstractDataProvider fmt = getProvider("convert/format");
        result = fmt.doRequest({
            "data": imgdata,
            "format": "JPEG",
        });
        assertEq("JPEG", result.format, "convert from binary data format");

        # Emboss with binary input
        AbstractDataProvider emboss = getProvider("image/effects/emboss");
        result = emboss.doRequest({
            "data": imgdata,
        });
        assertEq(60, result.width, "emboss from binary data width");
    }

    # ==================== Location Input Tests ====================

    locationInputTest() {
        # Test actions accept location string input (file:// scheme)
        string location = "file://" + testImagePath;

        # Resize with location input
        AbstractDataProvider resize = getProvider("image/resize");
        hash<auto> result = resize.doRequest({
            "location": location,
            "width": 50,
            "height": 40,
        });
        assertEq(50, result.width, "resize from location width");
        assertEq(40, result.height, "resize from location height");

        # Get info with location input
        AbstractDataProvider info = getProvider("info/get");
        hash<auto> infoResult = info.doRequest({
            "location": location,
        });
        assertEq(100, infoResult.width, "get-info from location width");
        assertEq(80, infoResult.height, "get-info from location height");
        assertEq("PNG", infoResult.format, "get-info from location format");

        # Composite with overlay_location
        AbstractDataProvider composite = getProvider("image/composite");
        # Create an overlay file for the location test
        string overlayPath = testDir + "/overlay_loc.png";
        MagickImage overlayImg(30, 20, "blue");
        overlayImg.setFormat("PNG");
        overlayImg.writeFile(overlayPath);
        result = composite.doRequest({
            "location": location,
            "overlay_location": "file://" + overlayPath,
            "x": 0,
            "y": 0,
        });
        assertEq(100, result.width, "composite from location width");
        assertEq(80, result.height, "composite from location height");
    }

    # ==================== Composite Action Tests ====================

    compositeActionTest() {
        AbstractDataProvider dp = getProvider("image/composite");

        # Create an overlay image
        MagickImage overlay(30, 20, "blue");
        overlay.setFormat("PNG");
        binary overlayData = overlay.toData();

        # Composite with coordinate placement
        hash<auto> result = dp.doRequest({
            "input_path": testImagePath,
            "overlay_data": overlayData,
            "operator": "Over",
            "x": 10,
            "y": 10,
        });
        assertEq(100, result.width, "composite preserves width");
        assertEq(80, result.height, "composite preserves height");
        assertGt(0, result.data.size(), "composite returns data");
        assertEq("PNG", result.format, "composite preserves format");
        assertEq(True, result.data instanceof binary, "composite returns binary data");

        # Composite with gravity placement
        result = dp.doRequest({
            "input_path": testImagePath,
            "overlay_data": overlayData,
            "operator": "Over",
            "gravity": "Center",
        });
        assertEq(100, result.width, "composite with gravity preserves width");
        assertEq(80, result.height, "composite with gravity preserves height");
        assertEq("PNG", result.format, "composite with gravity preserves format");

        # Composite with Multiply operator
        result = dp.doRequest({
            "input_path": testImagePath,
            "overlay_data": overlayData,
            "operator": "Multiply",
            "x": 0,
            "y": 0,
        });
        assertEq(100, result.width, "composite multiply preserves width");
        assertEq(80, result.height, "composite multiply preserves height");
        assertGt(0, result.data.size(), "composite multiply returns data");

        # Composite with output format override
        result = dp.doRequest({
            "input_path": testImagePath,
            "overlay_data": overlayData,
            "operator": "Over",
            "x": 0,
            "y": 0,
            "output_format": "JPEG",
        });
        assertEq("JPEG", result.format, "composite output_format override");
    }

    # ==================== Annotate Action Tests ====================

    annotateActionTest() {
        AbstractDataProvider dp = getProvider("image/annotate");

        # Basic annotation
        hash<auto> result = dp.doRequest({
            "input_path": testImagePath,
            "text": "Test",
            "x": 10.0,
            "y": 30.0,
        });
        assertEq(100, result.width, "annotate preserves width");
        assertEq(80, result.height, "annotate preserves height");
        assertGt(0, result.data.size(), "annotate returns data");
        assertEq("PNG", result.format, "annotate preserves format");
        assertEq(True, result.data instanceof binary, "annotate returns binary data");

        # Annotation with font options
        result = dp.doRequest({
            "input_path": testImagePath,
            "text": "Styled",
            "x": 5.0,
            "y": 50.0,
            "font_size": 24.0,
            "fill_color": "white",
        });
        assertEq(100, result.width, "annotate with options preserves width");
        assertEq(80, result.height, "annotate with options preserves height");
        assertEq("PNG", result.format, "annotate with options preserves format");

        # Annotation with angle
        result = dp.doRequest({
            "input_path": testImagePath,
            "text": "Rotated",
            "x": 20.0,
            "y": 40.0,
            "angle": 45.0,
            "fill_color": "black",
        });
        assertEq(100, result.width, "annotate with angle preserves width");
        assertEq(80, result.height, "annotate with angle preserves height");
        assertGt(0, result.data.size(), "annotate with angle returns data");

        # Annotation with output format override
        result = dp.doRequest({
            "input_path": testImagePath,
            "text": "Format",
            "x": 10.0,
            "y": 30.0,
            "output_format": "JPEG",
        });
        assertEq("JPEG", result.format, "annotate output_format override");
    }

    # ==================== Output Path Tests ====================

    outputPathTest() {
        AbstractDataProvider resize = getProvider("image/resize");

        # Test output_path: write resized image to file
        string outPath = testDir + "/output_resize.png";
        hash<auto> result = resize.doRequest({
            "input_path": testImagePath,
            "width": 50,
            "height": 40,
            "output_path": outPath,
        });
        assertEq(50, result.width, "output_path resize width");
        assertEq(40, result.height, "output_path resize height");
        assertEq(outPath, result.output_path, "output_path in response");
        assertEq(True, !exists result.data, "output_path: data not returned by default");
        assertEq(True, is_file(outPath), "output file exists");

        # Verify the written file has correct dimensions
        MagickImage written(outPath);
        assertEq(50, written.width(), "written file width");
        assertEq(40, written.height(), "written file height");

        # Test output_path with composite
        AbstractDataProvider composite = getProvider("image/composite");
        binary overlayData = createTestImageData(30, 20, "blue");
        string compositeOutPath = testDir + "/output_composite.png";
        result = composite.doRequest({
            "input_path": testImagePath,
            "overlay_data": overlayData,
            "operator": "Over",
            "x": 0,
            "y": 0,
            "output_path": compositeOutPath,
        });
        assertEq(compositeOutPath, result.output_path, "composite output_path in response");
        assertEq(True, is_file(compositeOutPath), "composite output file exists");
        assertEq(True, !exists result.data, "composite output_path: data not returned by default");

        # Test output_path with annotate
        AbstractDataProvider annotate = getProvider("image/annotate");
        string annotateOutPath = testDir + "/output_annotate.png";
        result = annotate.doRequest({
            "input_path": testImagePath,
            "text": "Test",
            "x": 10.0,
            "y": 30.0,
            "output_path": annotateOutPath,
        });
        assertEq(annotateOutPath, result.output_path, "annotate output_path in response");
        assertEq(True, is_file(annotateOutPath), "annotate output file exists");

        # Test output_path with format conversion
        AbstractDataProvider fmt = getProvider("convert/format");
        string fmtOutPath = testDir + "/output_convert.jpg";
        result = fmt.doRequest({
            "input_path": testImagePath,
            "format": "JPEG",
            "output_path": fmtOutPath,
        });
        assertEq(fmtOutPath, result.output_path, "convert output_path in response");
        assertEq("JPEG", result.format, "convert with output_path format");
        assertEq(True, is_file(fmtOutPath), "convert output file exists");
    }

    # ==================== Output Location Tests ====================

    outputLocationTest() {
        AbstractDataProvider resize = getProvider("image/resize");

        # Test output_location with file:// scheme
        string outPath = testDir + "/output_location_resize.png";
        string outLocation = "file://" + outPath;
        hash<auto> result = resize.doRequest({
            "input_path": testImagePath,
            "width": 50,
            "height": 40,
            "output_location": outLocation,
        });
        assertEq(50, result.width, "output_location resize width");
        assertEq(40, result.height, "output_location resize height");
        assertEq(outLocation, result.output_location, "output_location in response");
        assertEq(True, !exists result.data, "output_location: data not returned by default");
        assertEq(True, is_file(outPath), "output_location file exists");

        # Verify the written file has correct dimensions
        MagickImage written(outPath);
        assertEq(50, written.width(), "output_location written file width");
        assertEq(40, written.height(), "output_location written file height");

        # Test both output_path and output_location together
        string outPath2 = testDir + "/output_both_path.png";
        string outLoc2 = "file://" + testDir + "/output_both_loc.png";
        result = resize.doRequest({
            "input_path": testImagePath,
            "width": 25,
            "height": 20,
            "output_path": outPath2,
            "output_location": outLoc2,
        });
        string outLocPath2 = testDir + "/output_both_loc.png";
        assertEq(True, is_file(outPath2), "both: output_path file exists");
        assertEq(True, is_file(outLocPath2), "both: output_location file exists");
        assertEq(outPath2, result.output_path, "both: output_path in response");
        assertEq(outLoc2, result.output_location, "both: output_location in response");

        # Verify both output files have identical dimensions and size
        MagickImage outImgPath(outPath2);
        MagickImage outImgLoc(outLocPath2);
        assertEq(25, outImgPath.width(), "both: output_path image width");
        assertEq(20, outImgPath.height(), "both: output_path image height");
        assertEq(25, outImgLoc.width(), "both: output_location image width");
        assertEq(20, outImgLoc.height(), "both: output_location image height");
        assertEq(hstat(outPath2).size, hstat(outLocPath2).size, "both: output files have identical size");
    }

    # ==================== Return Data Tests ====================

    returnDataTest() {
        AbstractDataProvider resize = getProvider("image/resize");

        # Default without output: data is returned
        hash<auto> result = resize.doRequest({
            "input_path": testImagePath,
            "width": 50,
            "height": 40,
        });
        assertEq(True, result.data instanceof binary, "no output: data returned by default");

        # Default with output_path: data is NOT returned
        string outPath = testDir + "/return_data_default.png";
        result = resize.doRequest({
            "input_path": testImagePath,
            "width": 50,
            "height": 40,
            "output_path": outPath,
        });
        assertEq(True, !exists result.data, "with output: data not returned by default");

        # Explicit return_data: True with output_path: both data and file
        string outPath2 = testDir + "/return_data_true.png";
        result = resize.doRequest({
            "input_path": testImagePath,
            "width": 50,
            "height": 40,
            "output_path": outPath2,
            "return_data": True,
        });
        assertEq(True, result.data instanceof binary, "return_data True: data returned");
        assertEq(True, is_file(outPath2), "return_data True: file also written");
        assertEq(outPath2, result.output_path, "return_data True: output_path in response");

        # Explicit return_data: False without output: data not returned
        result = resize.doRequest({
            "input_path": testImagePath,
            "width": 50,
            "height": 40,
            "return_data": False,
        });
        assertEq(True, !exists result.data, "return_data False: data not returned");
        assertEq(50, result.width, "return_data False: width still present");
        assertEq(40, result.height, "return_data False: height still present");
        assertGt(0, result.size, "return_data False: size still present");

        # Explicit return_data: False with output_path
        string outPath3 = testDir + "/return_data_false_output.png";
        result = resize.doRequest({
            "input_path": testImagePath,
            "width": 50,
            "height": 40,
            "output_path": outPath3,
            "return_data": False,
        });
        assertEq(True, !exists result.data, "return_data False + output: data not returned");
        assertEq(True, is_file(outPath3), "return_data False + output: file written");

        # Explicit return_data: True without output: data returned (same as default)
        result = resize.doRequest({
            "input_path": testImagePath,
            "width": 50,
            "height": 40,
            "return_data": True,
        });
        assertEq(True, result.data instanceof binary, "return_data True no output: data returned");

        # Test with output_format override and output_path
        string outPath4 = testDir + "/return_data_format.jpg";
        result = resize.doRequest({
            "input_path": testImagePath,
            "width": 50,
            "height": 40,
            "output_format": "JPEG",
            "output_path": outPath4,
            "return_data": True,
        });
        assertEq("JPEG", result.format, "output_format + output_path: format correct");
        assertEq(True, result.data instanceof binary, "output_format + output_path: data returned");
        assertEq(True, is_file(outPath4), "output_format + output_path: file written");
    }

    # ==================== Error Handling Tests ====================

    errorHandlingTest() {
        AbstractDataProvider resize = getProvider("image/resize");

        # Test with nonexistent file
        assertThrows("IMAGEMAGICK-ERROR", \resize.doRequest(), ({
            "input_path": "/nonexistent/path/to/image.png",
            "width": 50,
            "height": 40,
        },));

        # Test get-info with nonexistent file
        AbstractDataProvider info = getProvider("info/get");
        assertThrows("IMAGEMAGICK-ERROR", \info.doRequest(), ({
            "input_path": "/nonexistent/path.png",
        },));

        # Test missing input source (caught by DataProvider required field group validation)
        assertThrows("REQUIRED-FIELD-GROUP-ERROR", \resize.doRequest(), ({
            "width": 50,
            "height": 40,
        },));

        # Test composite missing overlay source (caught by DataProvider required field group validation)
        AbstractDataProvider composite = getProvider("image/composite");
        assertThrows("REQUIRED-FIELD-GROUP-ERROR", \composite.doRequest(), ({
            "input_path": testImagePath,
            "operator": "Over",
            "x": 0,
            "y": 0,
        },));
    }

