    globalSetUp() {
        mkdir(testDir);
        # Create a test image file
        MagickImage img(100, 80, "red");
        img.setFormat("PNG");
        testImagePath = testDir + "/test.png";
        img.writeFile(testImagePath);
    }

    globalTearDown() {
        if (is_dir(testDir)) {
            system("rm -rf " + testDir);
        }
    }

    #! Helper: get a data provider by path from the factory
    private AbstractDataProvider getProvider(string path) {
        AbstractDataProviderFactory f = DataProvider::getFactoryEx("imagemagick");
        AbstractDataProvider p = f.create();
        list<string> parts = path.split("/");
        for (int i = 0; i < parts.size(); ++i) {
            p = p.getChildProvider(parts[i]);
        }
        return p;
    }

    #! Helper: create binary test image data
    private binary createTestImageData(int width = 100, int height = 80, string color = "white") {
        MagickImage img(width, height, color);
        img.setFormat("PNG");
        return img.toData();
    }

    # ==================== Module Loading Tests ====================

    moduleLoadingTest() {
        # Verify the module loaded successfully
        assertEq(True, True, "ImageMagickDataProvider module loaded");

        # Verify factory is registered
        assertEq(True, DataProvider::getFactory("imagemagick") instanceof AbstractDataProviderFactory,
            "imagemagick factory registered");
    }

    # ==================== Factory Tests ====================

    factoryTest() {
        AbstractDataProviderFactory f = DataProvider::getFactoryEx("imagemagick");
        assertEq("ImageMagickDataProviderFactory", f.className(), "factory class name");

        # Create provider from factory
        AbstractDataProvider p = f.create();
        assertEq("imagemagick", p.getName(), "provider name from factory");
    }

    # ==================== App Registration Tests ====================

    appRegistrationTest() {
        # Verify app is registered
        *hash<DataProviderAppInfo> appInfo = DataProviderActionCatalog::getApp("ImageMagick");
        assertEq(True, exists appInfo, "ImageMagick app is registered");
        assertEq("ImageMagick", appInfo.name, "app name is ImageMagick");
        assertEq("ImageMagick", appInfo.display_name, "app display_name");
        assertEq(True, exists appInfo.short_desc, "app has short_desc");
        assertEq(True, exists appInfo.desc, "app has desc");
        assertEq(True, exists appInfo.logo, "app has logo");
        assertEq("imagemagick-logo.svg", appInfo.logo_file_name, "app logo_file_name");
        assertEq(MimeTypeSvg, appInfo.logo_mime_type, "app logo_mime_type");
    }

    # ==================== Provider Tree Tests ====================

    providerTreeTest() {
        AbstractDataProviderFactory f = DataProvider::getFactoryEx("imagemagick");
        AbstractDataProvider root = f.create();

        # Check root children
        *list<string> rootChildren = root.getChildProviderNames();
        assertEq(3, rootChildren.size(), "root has 3 children");
        assertEq(True, rootChildren.contains("image"), "root has image child");
        assertEq(True, rootChildren.contains("convert"), "root has convert child");
        assertEq(True, rootChildren.contains("info"), "root has info child");

        # Check image children
        AbstractDataProvider image = root.getChildProvider("image");
        *list<string> imageChildren = image.getChildProviderNames();
        assertEq(45, imageChildren.size(), "image has 45 children");
        # Original children
        assertEq(True, imageChildren.contains("resize"), "image has resize");
        assertEq(True, imageChildren.contains("crop"), "image has crop");
        assertEq(True, imageChildren.contains("rotate"), "image has rotate");
        assertEq(True, imageChildren.contains("flip"), "image has flip");
        assertEq(True, imageChildren.contains("blur"), "image has blur");
        assertEq(True, imageChildren.contains("sharpen"), "image has sharpen");
        assertEq(True, imageChildren.contains("brightness-contrast"), "image has brightness-contrast");
        assertEq(True, imageChildren.contains("composite"), "image has composite");
        assertEq(True, imageChildren.contains("annotate"), "image has annotate");
        assertEq(True, imageChildren.contains("thumbnail"), "image has thumbnail");
        assertEq(True, imageChildren.contains("auto-orient"), "image has auto-orient");
        assertEq(True, imageChildren.contains("strip"), "image has strip");
        assertEq(True, imageChildren.contains("effects"), "image has effects");
        # New children
        assertEq(True, imageChildren.contains("color"), "image has color");
        assertEq(True, imageChildren.contains("gaussian-blur"), "image has gaussian-blur");
        assertEq(True, imageChildren.contains("motion-blur"), "image has motion-blur");
        assertEq(True, imageChildren.contains("adaptive-blur"), "image has adaptive-blur");
        assertEq(True, imageChildren.contains("rotational-blur"), "image has rotational-blur");
        assertEq(True, imageChildren.contains("adaptive-sharpen"), "image has adaptive-sharpen");
        assertEq(True, imageChildren.contains("unsharp-mask"), "image has unsharp-mask");
        assertEq(True, imageChildren.contains("despeckle"), "image has despeckle");
        assertEq(True, imageChildren.contains("reduce-noise"), "image has reduce-noise");
        assertEq(True, imageChildren.contains("wavelet-denoise"), "image has wavelet-denoise");
        assertEq(True, imageChildren.contains("trim"), "image has trim");
        assertEq(True, imageChildren.contains("border"), "image has border");
        assertEq(True, imageChildren.contains("frame"), "image has frame");
        assertEq(True, imageChildren.contains("shear"), "image has shear");
        assertEq(True, imageChildren.contains("deskew"), "image has deskew");

        # Check effects children
        AbstractDataProvider effects = image.getChildProvider("effects");
        *list<string> effectsChildren = effects.getChildProviderNames();
        assertEq(16, effectsChildren.size(), "effects has 16 children");
        assertEq(True, effectsChildren.contains("charcoal"), "effects has charcoal");
        assertEq(True, effectsChildren.contains("sepia"), "effects has sepia");
        assertEq(True, effectsChildren.contains("oil-paint"), "effects has oil-paint");
        assertEq(True, effectsChildren.contains("edge"), "effects has edge");
        assertEq(True, effectsChildren.contains("emboss"), "effects has emboss");
        assertEq(True, effectsChildren.contains("solarize"), "effects has solarize");
        assertEq(True, effectsChildren.contains("posterize"), "effects has posterize");
        assertEq(True, effectsChildren.contains("vignette"), "effects has vignette");
        assertEq(True, effectsChildren.contains("sketch"), "effects has sketch");
        assertEq(True, effectsChildren.contains("wave"), "effects has wave");
        assertEq(True, effectsChildren.contains("swirl"), "effects has swirl");
        assertEq(True, effectsChildren.contains("implode"), "effects has implode");
        assertEq(True, effectsChildren.contains("shadow"), "effects has shadow");
        assertEq(True, effectsChildren.contains("shade"), "effects has shade");
        assertEq(True, effectsChildren.contains("add-noise"), "effects has add-noise");
        assertEq(True, effectsChildren.contains("blue-shift"), "effects has blue-shift");

        # Check color children
        AbstractDataProvider color = image.getChildProvider("color");
        *list<string> colorChildren = color.getChildProviderNames();
        assertEq(15, colorChildren.size(), "color has 15 children");
        assertEq(True, colorChildren.contains("negate"), "color has negate");
        assertEq(True, colorChildren.contains("normalize"), "color has normalize");
        assertEq(True, colorChildren.contains("equalize"), "color has equalize");
        assertEq(True, colorChildren.contains("auto-gamma"), "color has auto-gamma");
        assertEq(True, colorChildren.contains("auto-level"), "color has auto-level");
        assertEq(True, colorChildren.contains("enhance"), "color has enhance");
        assertEq(True, colorChildren.contains("white-balance"), "color has white-balance");
        assertEq(True, colorChildren.contains("gamma"), "color has gamma");
        assertEq(True, colorChildren.contains("modulate"), "color has modulate");
        assertEq(True, colorChildren.contains("level"), "color has level");
        assertEq(True, colorChildren.contains("contrast-stretch"), "color has contrast-stretch");
        assertEq(True, colorChildren.contains("linear-stretch"), "color has linear-stretch");
        assertEq(True, colorChildren.contains("sigmoidal-contrast"), "color has sigmoidal-contrast");
        assertEq(True, colorChildren.contains("transform-colorspace"), "color has transform-colorspace");
        assertEq(True, colorChildren.contains("threshold"), "color has threshold");

        # Check convert children
        AbstractDataProvider convert = root.getChildProvider("convert");
        *list<string> convertChildren = convert.getChildProviderNames();
        assertEq(1, convertChildren.size(), "convert has 1 child");
        assertEq(True, convertChildren.contains("format"), "convert has format");

        # Check info children
        AbstractDataProvider info = root.getChildProvider("info");
        *list<string> infoChildren = info.getChildProviderNames();
        assertEq(4, infoChildren.size(), "info has 4 children");
        assertEq(True, infoChildren.contains("get"), "info has get");
    }

    # ==================== Type Metadata Tests ====================

    typeMetadataTest() {
        # Test resize request type has required fields
        AbstractDataProvider resize = getProvider("image/resize");
        *AbstractDataProviderType reqType = resize.getRequestType();
        assertEq(True, reqType instanceof AbstractDataProviderType, "resize has request type");
        *AbstractDataProviderType respType = resize.getResponseType();
        assertEq(True, respType instanceof AbstractDataProviderType, "resize has response type");

        # Test get-info response type has expected fields
        AbstractDataProvider getinfo = getProvider("info/get");
        *AbstractDataProviderType infoResp = getinfo.getResponseType();
        assertEq(True, infoResp instanceof AbstractDataProviderType, "get-info has response type");
    }

    # ==================== Required Groups Tests ====================

    requiredGroupsTest() {
        # Verify that request types enforce required groups (input_path or data)
        AbstractDataProvider resize = getProvider("image/resize");
        *AbstractDataProviderType reqType = resize.getRequestType();
        assertEq(True, reqType instanceof AbstractDataProviderType, "resize request type exists");
    }

    # ==================== Resize Action Tests ====================

    resizeActionTest() {
        AbstractDataProvider resize = getProvider("image/resize");

        # Test resize with file path
        hash<auto> result = resize.doRequest({
            "input_path": testImagePath,
            "width": 50,
            "height": 40,
        });
        assertEq(50, result.width, "resize width from file");
        assertEq(40, result.height, "resize height from file");
        assertEq(True, result.data instanceof binary, "resize returns binary data");
        assertGt(0, result.size, "resize returns positive size");
        assertEq("PNG", result.format, "resize preserves format");

        # Test resize with filter
        result = resize.doRequest({
            "input_path": testImagePath,
            "width": 25,
            "height": 20,
            "filter": "Mitchell",
        });
        assertEq(25, result.width, "resize with filter width");
        assertEq(20, result.height, "resize with filter height");

        # Test resize with output format override
        result = resize.doRequest({
            "input_path": testImagePath,
            "width": 50,
            "height": 40,
            "output_format": "JPEG",
        });
        assertEq("JPEG", result.format, "resize with output_format override");
    }

    # ==================== Crop Action Tests ====================

    cropActionTest() {
        AbstractDataProvider crop = getProvider("image/crop");

        hash<auto> result = crop.doRequest({
            "input_path": testImagePath,
            "width": 50,
            "height": 40,
            "x": 10,
            "y": 10,
        });
        assertEq(50, result.width, "crop width");
        assertEq(40, result.height, "crop height");
        assertEq(True, result.data instanceof binary, "crop returns binary data");
    }

    # ==================== Rotate Action Tests ====================

    rotateActionTest() {
        AbstractDataProvider rotate = getProvider("image/rotate");

        # 90 degree rotation swaps width and height
        hash<auto> result = rotate.doRequest({
            "input_path": testImagePath,
            "degrees": 90.0,
        });
        assertEq(80, result.width, "rotate 90 swaps width");
        assertEq(100, result.height, "rotate 90 swaps height");

        # Rotation with background color
        result = rotate.doRequest({
            "input_path": testImagePath,
            "degrees": 45.0,
            "background": "black",
        });
        assertEq(True, result.data instanceof binary, "rotate with background returns data");
    }

    # ==================== Flip Action Tests ====================

    flipActionTest() {
        AbstractDataProvider flip = getProvider("image/flip");

        # Vertical flip
        hash<auto> result = flip.doRequest({
            "input_path": testImagePath,
            "direction": "vertical",
        });
        assertEq(100, result.width, "vertical flip preserves width");
        assertEq(80, result.height, "vertical flip preserves height");

        # Horizontal flip
        result = flip.doRequest({
            "input_path": testImagePath,
            "direction": "horizontal",
        });
        assertEq(100, result.width, "horizontal flip preserves width");
        assertEq(80, result.height, "horizontal flip preserves height");
    }

    # ==================== Blur Action Tests ====================

    blurActionTest() {
        AbstractDataProvider blur = getProvider("image/blur");

        hash<auto> result = blur.doRequest({
            "input_path": testImagePath,
            "radius": 0.0,
            "sigma": 2.0,
        });
        assertEq(100, result.width, "blur preserves width");
        assertEq(80, result.height, "blur preserves height");
        assertEq(True, result.data instanceof binary, "blur returns binary data");
    }

