    # ==================== Strip Action Tests ====================

    stripActionTest() {
        AbstractDataProvider strip = getProvider("image/strip");

        hash<auto> result = strip.doRequest({
            "input_path": testImagePath,
        });
        assertEq(100, result.width, "strip preserves width");
        assertEq(80, result.height, "strip preserves height");
        assertGt(0, result.size, "strip returns data");
    }

    # ==================== Charcoal Effect Tests ====================

    charcoalActionTest() {
        AbstractDataProvider charcoal = getProvider("image/effects/charcoal");

        hash<auto> result = charcoal.doRequest({
            "input_path": testImagePath,
