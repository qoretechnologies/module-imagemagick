%modern

%requires QUnit
%requires Util
%requires DataProvider
%requires imagemagick
%requires ImageMagickDataProvider

%exec-class ImageMagickDataProviderTest

public class ImageMagickDataProviderTest inherits QUnit::Test {
    private {
        string testDir;
        string testImagePath;
    }

    constructor() : Test("ImageMagickDataProviderTest", "1.0") {
        testDir = tmp_location() + "/imagemagick_dp_test_" + string(getpid());

        addTestCase("Module loading tests", \moduleLoadingTest());
        addTestCase("Factory tests", \factoryTest());
        addTestCase("App registration tests", \appRegistrationTest());
        addTestCase("Provider tree tests", \providerTreeTest());
        addTestCase("Type metadata tests", \typeMetadataTest());
        addTestCase("Required groups tests", \requiredGroupsTest());
        addTestCase("Resize action tests", \resizeActionTest());
        addTestCase("Crop action tests", \cropActionTest());
        addTestCase("Rotate action tests", \rotateActionTest());
        addTestCase("Flip action tests", \flipActionTest());
        addTestCase("Blur action tests", \blurActionTest());
        addTestCase("Sharpen action tests", \sharpenActionTest());
        addTestCase("Brightness/contrast action tests", \brightnessContrastActionTest());
        addTestCase("Thumbnail action tests", \thumbnailActionTest());
        addTestCase("Auto orient action tests", \autoOrientActionTest());
        addTestCase("Strip action tests", \stripActionTest());
        addTestCase("Charcoal effect tests", \charcoalActionTest());
        addTestCase("Sepia effect tests", \sepiaActionTest());
        addTestCase("Oil paint effect tests", \oilPaintActionTest());
        addTestCase("Edge effect tests", \edgeActionTest());
        addTestCase("Emboss effect tests", \embossActionTest());
        addTestCase("Convert format action tests", \convertFormatActionTest());
        addTestCase("Get info action tests", \getInfoActionTest());
        addTestCase("Composite action tests", \compositeActionTest());
        addTestCase("Annotate action tests", \annotateActionTest());
        addTestCase("Binary data input tests", \binaryDataInputTest());
        addTestCase("Location input tests", \locationInputTest());
        addTestCase("Output path tests", \outputPathTest());
        addTestCase("Output location tests", \outputLocationTest());
        addTestCase("Return data tests", \returnDataTest());
        addTestCase("Error handling tests", \errorHandlingTest());

        # Color action tests
        addTestCase("Negate action tests", \negateActionTest());
        addTestCase("Normalize action tests", \normalizeActionTest());
        addTestCase("Equalize action tests", \equalizeActionTest());
        addTestCase("Auto-gamma action tests", \autoGammaActionTest());
        addTestCase("Auto-level action tests", \autoLevelActionTest());
        addTestCase("Enhance action tests", \enhanceActionTest());
        addTestCase("White-balance action tests", \whiteBalanceActionTest());
        addTestCase("Gamma action tests", \gammaActionTest());
        addTestCase("Modulate action tests", \modulateActionTest());
        addTestCase("Level action tests", \levelActionTest());
        addTestCase("Contrast-stretch action tests", \contrastStretchActionTest());
        addTestCase("Linear-stretch action tests", \linearStretchActionTest());
        addTestCase("Sigmoidal-contrast action tests", \sigmoidalContrastActionTest());
        addTestCase("Transform-colorspace action tests", \transformColorspaceActionTest());
        addTestCase("Threshold action tests", \thresholdActionTest());

        # Additional effects tests
        addTestCase("Solarize action tests", \solarizeActionTest());
        addTestCase("Posterize action tests", \posterizeActionTest());
        addTestCase("Vignette action tests", \vignetteActionTest());
        addTestCase("Sketch action tests", \sketchActionTest());
        addTestCase("Wave action tests", \waveActionTest());
        addTestCase("Swirl action tests", \swirlActionTest());
        addTestCase("Implode action tests", \implodeActionTest());
        addTestCase("Shadow action tests", \shadowActionTest());
        addTestCase("Shade action tests", \shadeActionTest());
        addTestCase("Add-noise action tests", \addNoiseActionTest());
        addTestCase("Blue-shift action tests", \blueShiftActionTest());

        # Blur/sharpen/denoise tests
        addTestCase("Gaussian-blur action tests", \gaussianBlurActionTest());
        addTestCase("Motion-blur action tests", \motionBlurActionTest());
        addTestCase("Adaptive-blur action tests", \adaptiveBlurActionTest());
        addTestCase("Rotational-blur action tests", \rotationalBlurActionTest());
        addTestCase("Adaptive-sharpen action tests", \adaptiveSharpenActionTest());
