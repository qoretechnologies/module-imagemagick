    sepiaActionTest() {
        AbstractDataProvider sepia = getProvider("image/effects/sepia");

        hash<auto> result = sepia.doRequest({
            "input_path": testImagePath,
            "threshold": 52000.0,
        });
        assertEq(100, result.width, "sepia preserves width");
