        assertEq(True, result.height > 0, "deskew returns positive height");
        assertEq(True, result.data instanceof binary, "deskew returns binary data");
    }

    # ==================== Phase 1: High-Value Image Operations ====================

    scaleActionTest() {
        AbstractDataProvider dp = getProvider("image/scale");

        hash<auto> result = dp.doRequest({
            "input_path": testImagePath,
            "width": 50,
            "height": 40,
        });
        assertEq(50, result.width, "scale width");
        assertEq(40, result.height, "scale height");
        assertEq(True, result.data instanceof binary, "scale returns binary data");
    }

    resampleActionTest() {
        AbstractDataProvider dp = getProvider("image/resample");

        hash<auto> result = dp.doRequest({
            "input_path": testImagePath,
            "x_resolution": 150.0,
            "y_resolution": 150.0,
        });
        assertEq(True, result.width > 0, "resample returns positive width");
        assertEq(True, result.height > 0, "resample returns positive height");
        assertEq(True, result.data instanceof binary, "resample returns binary data");

        # Test with explicit filter
        result = dp.doRequest({
            "input_path": testImagePath,
            "x_resolution": 300.0,
            "y_resolution": 300.0,
            "filter": "Mitchell",
        });
        assertEq(True, result.width > 0, "resample with filter returns positive width");
    }

    extentActionTest() {
        AbstractDataProvider dp = getProvider("image/extent");

        # Extend canvas larger
        hash<auto> result = dp.doRequest({
            "input_path": testImagePath,
            "width": 200,
            "height": 160,
        });
        assertEq(200, result.width, "extent width");
        assertEq(160, result.height, "extent height");
        assertEq(True, result.data instanceof binary, "extent returns binary data");

        # With offset
        result = dp.doRequest({
            "input_path": testImagePath,
            "width": 200,
            "height": 160,
            "x": 50,
            "y": 40,
        });
        assertEq(200, result.width, "extent with offset width");
        assertEq(160, result.height, "extent with offset height");
    }

    selectiveBlurActionTest() {
        AbstractDataProvider dp = getProvider("image/selective-blur");

        hash<auto> result = dp.doRequest({
            "input_path": testImagePath,
            "sigma": 2.0,
            "threshold": 0.1,
        });
        assertEq(100, result.width, "selective-blur width preserved");
        assertEq(80, result.height, "selective-blur height preserved");
        assertEq(True, result.data instanceof binary, "selective-blur returns binary data");

        # With explicit radius
        result = dp.doRequest({
            "input_path": testImagePath,
            "radius": 5.0,
            "sigma": 2.0,
            "threshold": 0.2,
        });
        assertEq(100, result.width, "selective-blur with radius width preserved");
    }

    liquidRescaleActionTest() {
        AbstractDataProvider dp = getProvider("image/liquid-rescale");

        try {
            hash<auto> result = dp.doRequest({
                "input_path": testImagePath,
                "width": 80,
                "height": 60,
            });
            assertEq(80, result.width, "liquid-rescale width");
            assertEq(60, result.height, "liquid-rescale height");
            assertEq(True, result.data instanceof binary, "liquid-rescale returns binary data");
        } catch (hash<ExceptionInfo> ex) {
            # Skip if liblqr is not available
            if (ex.err == "IMAGEMAGICK-ERROR" && ex.desc =~ /lqr|LQR|liquid|seam/i) {
                testSkip("liquidRescale not available (liblqr not compiled in)");
            }
            rethrow;
        }
    }

