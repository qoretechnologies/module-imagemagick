    # ==================== Oil Paint Effect Tests ====================

    oilPaintActionTest() {
        AbstractDataProvider oilPaint = getProvider("image/effects/oil-paint");

        hash<auto> result = oilPaint.doRequest({
            "input_path": testImagePath,
