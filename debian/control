Package: qore-imagemagick-module
Architecture: any
Depends: qore-imagemagick-module-common (= ${source:Version}),
         fonts-dejavu-core,
         fonts-urw-base35,
         ${qore:Depends},
         ${shlibs:Depends},
         ${misc:Depends}
Suggests: qore-imagemagick-module-doc
Description: image processing and data providers for Qore
 This package provides ImageMagick 7 bindings, the ImageMagickDataProvider
 source and compiled module, qimage, compiler metadata, provider resources
 and translations. It supports resizing, color and format conversion, effects,
 drawing, profiles and image metadata. Fonts are supplied for text rendering.

Package: qore-imagemagick-module-common
Architecture: all
Multi-Arch: foreign
Depends: ${misc:Depends}
Description: shared sources and translations for Qore's ImageMagick module
 This package contains the architecture-independent ImageMagickDataProvider
 source module, resources and translation catalogs used by the native and
 compiled Qore modules in qore-imagemagick-module.

Package: qore-imagemagick-module-doc
Section: doc
Architecture: all
Multi-Arch: foreign
Build-Profiles: <!nodoc>
Depends: ${misc:Depends}
Suggests: qore-imagemagick-module
Description: documentation and examples for Qore's ImageMagick modules
 This package contains HTML API references and example tests for the imagemagick
 native module and ImageMagickDataProvider.
