        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/set-depth",
            "action": "set-depth",
            "display_name": "Set Bit Depth",
            "short_desc": "Set image bit depth per channel",
            "desc": "Set the image bit depth (bits per channel). Common values: `8` (standard), "
                "`16` (high dynamic range), `32` (floating point).",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSetDepthRequestDataType::Fields{"depth",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSetDepthRequestDataType::Fields{"location",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSetDepthRequestDataType::Fields - ("depth", "location"),
