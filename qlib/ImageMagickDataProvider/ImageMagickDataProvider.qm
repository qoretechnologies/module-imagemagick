            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickLiquidRescaleRequestDataType::Fields
                    - ("width", "height", "location"),
            ),
            "output_type": ImageMagickLiquidRescaleDataProvider::ResponseType,
        });

        # ==================== Phase 2: Geometry Operations ====================

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/adaptive-resize",
            "action": "adaptive-resize",
            "display_name": "Adaptive Resize",
            "short_desc": "Resize using mesh interpolation",
            "desc": "Resize an image using adaptive mesh interpolation, which produces "
                "higher quality results for enlargement than standard resize",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickAdaptiveResizeRequestDataType::Fields{"width", "height"}, {
                    "preselected": True,
                    "required": True,
