            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickShaveRequestDataType::Fields{"location",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickShaveRequestDataType::Fields
                    - ("columns", "rows", "location"),
            ),
            "output_type": ImageMagickShaveDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/splice",
            "action": "splice",
            "display_name": "Splice Region",
            "short_desc": "Insert blank region into image",
            "desc": "Insert a blank region into an image at the specified position, "
                "pushing existing content apart. Image dimensions increase.\n\n"
                "The inverse of chop — useful for adding space between image sections, "
                "creating room for text or graphics, or inserting divider lines into "
                "composite images.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSpliceRequestDataType::Fields{"width", "height", "x", "y"}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSpliceRequestDataType::Fields{"location",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSpliceRequestDataType::Fields
                    - ("width", "height", "x", "y", "location"),
            ),
            "output_type": ImageMagickSpliceDataProvider::ResponseType,
        });

        # ==================== Phase 3: Metadata Actions ====================

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/set-resolution",
            "action": "set-resolution",
            "display_name": "Set Resolution",
            "short_desc": "Set image DPI resolution",
            "desc": "Set the image resolution (DPI) without resampling pixels. This "
                "changes the metadata only, not the pixel dimensions.\n\n"
                "Useful for setting the correct DPI for print production without "
                "altering the image content, or correcting incorrect resolution "
                "metadata in scanned documents.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSetResolutionRequestDataType::Fields{"x", "y"}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSetResolutionRequestDataType::Fields{"location",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSetResolutionRequestDataType::Fields - ("x", "y", "location"),
            ),
            "output_type": ImageMagickSetResolutionDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/set-depth",
            "action": "set-depth",
            "display_name": "Set Bit Depth",
            "short_desc": "Set image bit depth per channel",
            "desc": "Set the image bit depth (bits per channel).\n\n"
                "Common values:\n"
                "- `8` — standard (256 levels per channel)\n"
                "- `16` — high dynamic range (65,536 levels per channel)\n"
                "- `32` — floating point precision\n\n"
                "Useful for preparing images for professional editing workflows or "
                "converting between standard and high-dynamic-range formats.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSetDepthRequestDataType::Fields{"depth",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSetDepthRequestDataType::Fields{"location",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSetDepthRequestDataType::Fields - ("depth", "location"),
            ),
            "output_type": ImageMagickSetDepthDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/set-property",
            "action": "set-property",
            "display_name": "Set Property",
            "short_desc": "Set an image metadata property",
            "desc": "Set an image property (metadata) such as EXIF tags, comments, or "
                "custom application data.\n\n"
                "Useful for adding copyright information, descriptions, keywords, "
                "or custom metadata to images for cataloging and asset management.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSetPropertyRequestDataType::Fields{"name", "value"}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSetPropertyRequestDataType::Fields{"location",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSetPropertyRequestDataType::Fields - ("name", "value", "location"),
            ),
            "output_type": ImageMagickSetPropertyDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/set-profile",
            "action": "set-profile",
            "display_name": "Set Profile",
            "short_desc": "Set an image profile (ICC, IPTC, etc.)",
            "desc": "Set a binary image profile such as ICC color management, IPTC "
                "metadata, or XMP data.\n\n"
                "Essential for color management workflows — embed ICC profiles to "
                "ensure consistent color reproduction across different displays and "
                "printers. Also useful for embedding press metadata (IPTC) for "
                "news and stock photography.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSetProfileRequestDataType::Fields{"name", "profile_data"}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSetProfileRequestDataType::Fields{"location",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSetProfileRequestDataType::Fields
                    - ("name", "profile_data", "location"),
            ),
            "output_type": ImageMagickSetProfileDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/info/get-properties",
            "action": "get-properties",
            "display_name": "Get Properties",
            "short_desc": "Get image properties matching a pattern",
            "desc": "Retrieve image properties (metadata) matching a glob pattern.\n\n"
                "Use `exif:*` for EXIF data, `iptc:*` for IPTC, or `*` for all "
                "properties. Useful for auditing image metadata, extracting specific "
                "tags for cataloging, or verifying metadata before publishing.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickGetPropertiesRequestDataType::Fields{"location", "pattern"}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickGetPropertiesRequestDataType::Fields - ("location", "pattern"),
            ),
            "output_type": ImageMagickGetPropertiesDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/info/get-exif",
            "action": "get-exif",
            "display_name": "Get EXIF Data",
            "short_desc": "Get EXIF metadata from an image",
            "desc": "Retrieve EXIF metadata from an image. Returns property names with "
                "the `exif:` prefix stripped for cleaner output.\n\n"
                "Useful for extracting camera settings (aperture, shutter speed, ISO), "
                "GPS coordinates, timestamps, and other camera-recorded data from "
                "photographs.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickGetExifRequestDataType::Fields{"location",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickGetExifRequestDataType::Fields - ("location",),
            ),
            "output_type": ImageMagickGetExifDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/info/get-profile",
            "action": "get-profile",
            "display_name": "Get Profile",
            "short_desc": "Get image profile data (ICC, EXIF, etc.)",
            "desc": "Retrieve binary profile data from an image.\n\n"
                "Common profiles:\n"
                "- `icc` — ICC color management profile\n"
                "- `exif` — camera and capture metadata\n"
                "- `iptc` — press and editorial metadata\n"
                "- `xmp` — extensible metadata (Adobe)\n\n"
                "Useful for extracting profiles from one image to apply to another, "
                "auditing color management data, or archiving metadata.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickGetProfileRequestDataType::Fields{"name",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickGetProfileRequestDataType::Fields{"location",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickGetProfileRequestDataType::Fields - ("name", "location"),
            ),
            "output_type": ImageMagickGetProfileDataProvider::ResponseType,
        });

        # ==================== Phase 4: Drawing Action ====================

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/draw",
            "action": "draw",
            "display_name": "Draw on Image",
            "short_desc": "Draw vector graphics on an image",
            "desc": "Draw shapes, lines, and text on an image using vector graphics.\n\n"
                "**Supported operations**:\n"
                "- `line`, `rectangle`, `round-rectangle`, `circle`, `ellipse`, `arc`\n"
                "- `point`, `polygon`, `polyline`, `text`\n\n"
                "Each operation supports configurable fill color, stroke color, stroke "
                "width, opacity, and font settings. Useful for adding annotations, "
                "diagrams, measurement markers, or decorative elements to images.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickDrawRequestDataType::Fields{"operations",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickDrawRequestDataType::Fields{
                    "location", "fill_color", "stroke_color", "stroke_width",
                }, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickDrawRequestDataType::Fields
                    - ("operations", "location", "fill_color", "stroke_color", "stroke_width"),
            ),
            "output_type": ImageMagickDrawDataProvider::ResponseType,
        });
    };
}

public namespace ImageMagickDataProvider {
    #! Application name
    public const AppName = "ImageMagick";
}

namespace Priv {
    #! ImageMagick logo (loaded at initialization)
    const ImageMagickLogo = File::readTextFile(get_script_dir() + "/imagemagick-logo.svg");
}
