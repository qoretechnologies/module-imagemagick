            "output_type": ImageMagickShearDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/deskew",
            "action": "deskew",
            "display_name": "Deskew",
