            "output_type": ImageMagickExtentDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/selective-blur",
            "action": "selective-blur",
            "display_name": "Selective Blur",
            "short_desc": "Edge-preserving selective blur",
            "desc": "Apply a blur that only affects pixels within a contrast threshold of the "
                "center pixel, preserving edges and detail",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
