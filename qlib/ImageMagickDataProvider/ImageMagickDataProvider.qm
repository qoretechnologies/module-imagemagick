        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/shave",
            "action": "shave",
            "display_name": "Shave Edges",
            "short_desc": "Shave pixels from all image edges",
            "desc": "Shave pixels from the edges of an image. Removes the specified number "
