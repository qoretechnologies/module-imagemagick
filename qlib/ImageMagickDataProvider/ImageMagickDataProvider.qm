            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickAdaptiveResizeRequestDataType::Fields{"location",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickAdaptiveResizeRequestDataType::Fields
                    - ("width", "height", "location"),
            ),
            "output_type": ImageMagickAdaptiveResizeDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/sample",
            "action": "sample",
            "display_name": "Sample Resize",
            "short_desc": "Fastest resize using pixel sampling",
            "desc": "Resize an image using pixel sampling (nearest-neighbor). The fastest "
                "resize method but produces lower quality results.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSampleRequestDataType::Fields{"width", "height"}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSampleRequestDataType::Fields{"location",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSampleRequestDataType::Fields - ("width", "height", "location"),
            ),
            "output_type": ImageMagickSampleDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
