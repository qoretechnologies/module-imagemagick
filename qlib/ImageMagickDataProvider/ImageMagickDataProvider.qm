%requires qore >= 2.0

%requires DataProvider
%requires FileLocationHandler
%requires Mime
%requires imagemagick

%modern

module ImageMagickDataProvider {
    version = "1.0";
    desc = "Qore ImageMagick data provider module";
    author = "Qore Technologies, s.r.o.";
    url = "https://github.com/qoretechnologies/module-imagemagick";
    license = "MIT";
    init = sub () {
        # register the data provider factory
        DataProvider::registerFactory(new ImageMagickDataProviderFactory());

        # register app
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": ImageMagickDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "ImageMagick",
            "short_desc": "Image processing and manipulation with ImageMagick",
            "desc": "Process and manipulate images using "
                "[ImageMagick](https://imagemagick.org), a powerful image processing "
                "library.\n\n"
                "**Image Operations**:\n"
                "- Resize, crop, rotate, flip, scale, and resample images\n"
                "- Create thumbnails and apply content-aware liquid rescaling\n"
                "- Trim borders, add borders and frames, shear, and deskew\n\n"
                "**Effects and Filters**:\n"
                "- Blur, sharpen, and denoise with multiple algorithms\n"
                "- Artistic effects: charcoal, sepia, oil paint, sketch, and more\n"
                "- Color adjustments: brightness, contrast, gamma, levels, and "
                "colorspace conversion\n\n"
                "**Drawing and Annotation**:\n"
                "- Draw shapes, lines, polygons, and text on images\n"
                "- Add watermarks, copyright text, and visual annotations\n\n"
                "**Format and Metadata**:\n"
                "- Convert between 200+ image formats (PNG, JPEG, WebP, AVIF, TIFF, "
                "and more)\n"
                "- Read and write EXIF, IPTC, XMP, and ICC color profiles\n"
                "- Set image resolution, bit depth, and custom properties",
            "groups": (DataProvider::AppGroup::DesignCreative,),
            "logo": ImageMagickLogo,
            "logo_file_name": "imagemagick-logo.svg",
            "logo_mime_type": MimeTypeSvg,
        });

        # register actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/resize",
            "action": "resize",
            "display_name": "Resize Image",
            "short_desc": "Resize an image to specified dimensions",
            "desc": "Resize an image to specific pixel dimensions using high-quality filtering "
                "algorithms.\n\n"
                "Common use cases include preparing images for web display, social media, "
                "email templates, or print production. Choose from multiple filter algorithms "
                "(e.g. `Lanczos`, `Mitchell`) to balance quality and performance.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickResizeRequestDataType::Fields{"width", "height"}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickResizeRequestDataType::Fields{"location", "filter"}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickResizeRequestDataType::Fields
                    - ("width", "height", "location", "filter"),
            ),
            "output_type": ImageMagickResizeDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/crop",
            "action": "crop",
            "display_name": "Crop Image",
            "short_desc": "Crop an image to a specified region",
            "desc": "Extract a rectangular region from an image by specifying the crop area's "
                "width, height, and position.\n\n"
                "Useful for removing unwanted borders, focusing on a specific subject, "
                "or preparing images with exact dimensions for layouts and templates.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickCropRequestDataType::Fields{"width", "height"}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickCropRequestDataType::Fields{"location", "x", "y"}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickCropRequestDataType::Fields
                    - ("width", "height", "location", "x", "y"),
            ),
            "output_type": ImageMagickCropDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/rotate",
            "action": "rotate",
            "display_name": "Rotate Image",
            "short_desc": "Rotate an image by a specified angle",
            "desc": "Rotate an image clockwise by the given number of degrees. Areas exposed "
                "by the rotation are filled with a configurable background color.\n\n"
                "Useful for correcting image orientation, creating angled compositions, "
                "or preparing images for specific layout requirements.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickRotateRequestDataType::Fields{"degrees",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickRotateRequestDataType::Fields{"location",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickRotateRequestDataType::Fields - ("degrees", "location"),
            ),
            "output_type": ImageMagickRotateDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/flip",
            "action": "flip",
            "display_name": "Flip Image",
            "short_desc": "Flip or mirror an image",
            "desc": "Flip an image vertically (top to bottom) or horizontally (left to right "
                "mirror).\n\n"
                "Useful for creating mirror effects, correcting camera-mirrored selfies, "
                "or producing symmetrical design elements.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickFlipRequestDataType::Fields{"location", "direction"}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickFlipRequestDataType::Fields - ("location", "direction"),
            ),
            "output_type": ImageMagickFlipDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/blur",
            "action": "blur",
            "display_name": "Blur Image",
            "short_desc": "Apply a blur filter to an image",
            "desc": "Apply a Gaussian blur filter with configurable radius and sigma "
                "parameters.\n\n"
                "Useful for softening images, creating background effects, reducing noise, "
                "or producing depth-of-field effects for product photography and marketing "
                "materials.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickBlurRequestDataType::Fields{"sigma",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickBlurRequestDataType::Fields{"location",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickBlurRequestDataType::Fields - ("sigma", "location"),
            ),
            "output_type": ImageMagickBlurDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/sharpen",
            "action": "sharpen",
            "display_name": "Sharpen Image",
            "short_desc": "Apply a sharpening filter to an image",
            "desc": "Sharpen an image with configurable radius and sigma parameters to "
                "enhance fine detail and edges.\n\n"
                "Useful for improving clarity of photos after resizing, enhancing text "
                "readability in scanned documents, or restoring detail in slightly "
                "out-of-focus images.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSharpenRequestDataType::Fields{"sigma",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSharpenRequestDataType::Fields{"location",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSharpenRequestDataType::Fields - ("sigma", "location"),
            ),
            "output_type": ImageMagickSharpenDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/brightness-contrast",
            "action": "brightness-contrast",
            "display_name": "Adjust Brightness/Contrast",
            "short_desc": "Adjust image brightness and contrast",
            "desc": "Adjust the brightness and contrast of an image using percentage "
                "values.\n\n"
                "Useful for correcting underexposed or overexposed photos, improving "
                "visibility of scanned documents, or enhancing product images for "
                "e-commerce listings.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickBrightnessContrastRequestDataType::Fields{
                    "location", "brightness", "contrast",
                }, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickBrightnessContrastRequestDataType::Fields
                    - ("location", "brightness", "contrast"),
            ),
            "output_type": ImageMagickBrightnessContrastDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/composite",
            "action": "composite",
            "display_name": "Composite Images",
            "short_desc": "Overlay one image onto another",
            "desc": "Composite (overlay) one image onto another using various blending "
                "operators and gravity-based or coordinate-based positioning.\n\n"
                "Common use cases include adding watermarks and logos, creating image "
                "collages, overlaying graphics onto photos, and combining layers for "
                "design compositions.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickCompositeRequestDataType::Fields{
                    "location", "overlay_location", "operator",
                }, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickCompositeRequestDataType::Fields
                    - ("location", "overlay_location", "operator"),
            ),
            "output_type": ImageMagickCompositeDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/annotate",
            "action": "annotate",
            "display_name": "Annotate Image",
            "short_desc": "Add text annotation to an image",
            "desc": "Draw text on an image with configurable font, size, color, and "
                "position.\n\n"
                "Useful for adding copyright notices, watermarks, captions, labels, "
                "timestamps, or other text overlays to images. Supports custom fonts "
                "and precise positioning.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickAnnotateRequestDataType::Fields{"text", "x", "y"}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickAnnotateRequestDataType::Fields{
                    "location", "font_size", "fill_color",
                }, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickAnnotateRequestDataType::Fields
                    - ("text", "x", "y", "location", "font_size", "fill_color"),
            ),
            "output_type": ImageMagickAnnotateDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/thumbnail",
            "action": "thumbnail",
            "display_name": "Create Thumbnail",
            "short_desc": "Create a thumbnail of an image",
            "desc": "Create a fast, optimized thumbnail of an image at the specified "
                "dimensions.\n\n"
                "Optimized for speed over quality — ideal for generating preview images, "
                "gallery thumbnails, or image index pages in bulk processing workflows.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickThumbnailRequestDataType::Fields{"width", "height"}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickThumbnailRequestDataType::Fields{"location",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickThumbnailRequestDataType::Fields
                    - ("width", "height", "location"),
            ),
            "output_type": ImageMagickThumbnailDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/auto-orient",
            "action": "auto-orient",
            "display_name": "Auto Orient",
            "short_desc": "Automatically orient an image based on EXIF data",
            "desc": "Automatically adjust image orientation based on its EXIF orientation "
                "tag.\n\n"
                "Essential for processing photos from smartphones and digital cameras, "
                "which often store rotation information in EXIF metadata rather than "
                "rotating the actual pixel data. Ensures images display correctly "
                "regardless of how the camera was held.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickAutoOrientRequestDataType::Fields{"location",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickAutoOrientRequestDataType::Fields - ("location",),
            ),
            "output_type": ImageMagickAutoOrientDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/strip",
            "action": "strip",
            "display_name": "Strip Metadata",
            "short_desc": "Remove all metadata and profiles from an image",
            "desc": "Strip all profiles, comments, and metadata from an image.\n\n"
                "Useful for reducing file size before web publishing, removing sensitive "
                "location data (GPS coordinates) from photos, or cleaning images for "
                "privacy compliance before sharing.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickStripRequestDataType::Fields{"location",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickStripRequestDataType::Fields - ("location",),
            ),
            "output_type": ImageMagickStripDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/effects/charcoal",
            "action": "charcoal",
            "display_name": "Charcoal Effect",
            "short_desc": "Apply a charcoal drawing effect",
            "desc": "Transform an image to look like a charcoal drawing with configurable "
                "intensity.\n\n"
                "Creates an artistic black-and-white sketch effect. Useful for creating "
                "stylized profile pictures, artistic prints, or design assets.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickCharcoalRequestDataType::Fields{
                    "location", "radius", "sigma",
                }, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickCharcoalRequestDataType::Fields
                    - ("location", "radius", "sigma"),
            ),
            "output_type": ImageMagickCharcoalDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/effects/sepia",
            "action": "sepia",
            "display_name": "Sepia Tone",
            "short_desc": "Apply a sepia tone effect",
            "desc": "Apply a warm sepia tone effect to an image for a vintage, antique "
                "appearance.\n\n"
                "Useful for creating nostalgic or vintage-themed marketing materials, "
                "photo albums, and artistic presentations.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSepiaRequestDataType::Fields{"location", "threshold"}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSepiaRequestDataType::Fields - ("location", "threshold"),
            ),
            "output_type": ImageMagickSepiaDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/effects/oil-paint",
            "action": "oil-paint",
            "display_name": "Oil Paint Effect",
            "short_desc": "Apply an oil painting effect",
            "desc": "Transform an image to look like an oil painting with configurable "
                "brush size.\n\n"
                "Creates an artistic painterly effect useful for creating stylized "
                "artwork, decorative prints, or unique visual content.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickOilPaintRequestDataType::Fields{"location", "radius", "sigma"}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickOilPaintRequestDataType::Fields - ("location", "radius", "sigma"),
            ),
            "output_type": ImageMagickOilPaintDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/effects/edge",
            "action": "edge",
            "display_name": "Edge Detection",
            "short_desc": "Apply edge detection filter",
            "desc": "Detect and highlight edges in an image, producing a high-contrast "
                "outline.\n\n"
                "Useful for image analysis, creating line-art versions of photos, or "
                "generating outlines for tracing and design work.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickEdgeRequestDataType::Fields{"location", "radius"}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickEdgeRequestDataType::Fields - ("location", "radius"),
            ),
            "output_type": ImageMagickEdgeDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/effects/emboss",
            "action": "emboss",
            "display_name": "Emboss Effect",
            "short_desc": "Apply an emboss (3D) effect",
            "desc": "Apply a 3D embossing effect to an image, making it appear raised or "
                "stamped.\n\n"
                "Creates a textured, relief-like appearance useful for creating decorative "
                "backgrounds, artistic effects, or visual textures.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickEmbossRequestDataType::Fields{
                    "location", "radius", "sigma",
                }, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickEmbossRequestDataType::Fields
                    - ("location", "radius", "sigma"),
            ),
            "output_type": ImageMagickEmbossDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/convert/format",
            "action": "convert-format",
            "display_name": "Convert Format",
            "short_desc": "Convert image to a different format",
            "desc": "Convert an image to a different format with configurable compression "
                "quality.\n\n"
                "Common formats are listed in the dropdown, but ImageMagick supports "
                "200+ formats including raw camera formats, scientific formats, and more. "
                "Any valid ImageMagick format name can be typed directly.\n\n"
                "Useful for batch format conversion (e.g. TIFF to JPEG for web), "
                "optimizing file sizes, preparing images for specific platforms, or "
                "converting between professional and web-friendly formats.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickConvertFormatRequestDataType::Fields{"format",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickConvertFormatRequestDataType::Fields{"location", "quality"}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickConvertFormatRequestDataType::Fields
                    - ("format", "location", "quality"),
            ),
            "output_type": ImageMagickConvertFormatDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/info/get",
            "action": "get-info",
            "display_name": "Get Image Info",
            "short_desc": "Get image metadata and dimensions",
            "desc": "Retrieve image metadata including dimensions, format, colorspace, "
                "resolution, and other properties.\n\n"
                "Useful for inventory and cataloging workflows, validating image "
                "specifications before processing, quality assurance checks, or building "
                "image asset databases.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickGetInfoRequestDataType::Fields{"location",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickGetInfoRequestDataType::Fields - ("location",),
            ),
            "output_type": ImageMagickGetInfoDataProvider::ResponseType,
        });

        # ==================== Color Adjustment Actions ====================

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/color/negate",
            "action": "negate",
            "display_name": "Negate Colors",
            "short_desc": "Negate image colors",
            "desc": "Negate (invert) the colors of an image, producing a photographic "
                "negative effect.\n\n"
                "Useful for creating artistic effects, generating negative versions of "
                "X-rays or scanned documents, or producing inverted design elements.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickNegateRequestDataType::Fields{"location", "gray_only"}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickNegateRequestDataType::Fields - ("location", "gray_only"),
            ),
            "output_type": ImageMagickNegateDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/color/normalize",
            "action": "normalize",
            "display_name": "Normalize",
            "short_desc": "Normalize image histogram",
            "desc": "Automatically stretch the image histogram to span the full range of "
                "values, improving overall contrast.\n\n"
                "Useful for quickly improving photos that appear washed out or flat, "
                "enhancing scanned documents for readability, or as a preprocessing "
                "step before further color adjustments.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickNormalizeRequestDataType::Fields{"location",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickNormalizeRequestDataType::Fields - ("location",),
            ),
            "output_type": ImageMagickNormalizeDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/color/equalize",
            "action": "equalize",
            "display_name": "Equalize",
            "short_desc": "Equalize image histogram",
            "desc": "Equalize the image histogram to produce a more uniform intensity "
                "distribution across the tonal range.\n\n"
                "Useful for improving contrast in images with uneven lighting, enhancing "
                "details in dark or bright regions, or normalizing a batch of images "
                "to a consistent appearance.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickEqualizeRequestDataType::Fields{"location",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickEqualizeRequestDataType::Fields - ("location",),
            ),
            "output_type": ImageMagickEqualizeDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/color/auto-gamma",
            "action": "auto-gamma",
            "display_name": "Auto Gamma",
            "short_desc": "Auto-adjust image gamma",
            "desc": "Automatically adjust image gamma for optimal brightness by analyzing "
                "the image histogram.\n\n"
                "Useful for quick brightness correction of photos that are too dark or "
                "too bright without manual parameter tuning.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickAutoGammaRequestDataType::Fields{"location",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickAutoGammaRequestDataType::Fields - ("location",),
