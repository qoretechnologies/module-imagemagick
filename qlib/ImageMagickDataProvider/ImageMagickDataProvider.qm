        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/liquid-rescale",
            "action": "liquid-rescale",
            "display_name": "Liquid Rescale",
            "short_desc": "Content-aware resize using seam carving",
            "desc": "Resize an image using content-aware seam carving, which intelligently "
                "removes or adds pixels along low-energy seams to preserve important content. "
                "Requires ImageMagick built with liblqr support.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickLiquidRescaleRequestDataType::Fields{"width", "height"}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickLiquidRescaleRequestDataType::Fields{"location",}, {
