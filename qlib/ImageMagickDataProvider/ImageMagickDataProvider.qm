                ImageMagickFrameRequestDataType::Fields{"location",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickFrameRequestDataType::Fields
                    - ("color", "width", "height", "inner_bevel", "outer_bevel", "location"),
            ),
            "output_type": ImageMagickFrameDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/shear",
            "action": "shear",
            "display_name": "Shear Transform",
            "short_desc": "Apply shear transformation",
            "desc": "Shear an image along the X and/or Y axis. Image dimensions may change.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickShearRequestDataType::Fields{"x", "y"}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickShearRequestDataType::Fields{"location",}, {
