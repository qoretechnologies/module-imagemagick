            "path": "/image/splice",
            "action": "splice",
            "display_name": "Splice Region",
            "short_desc": "Insert blank region into image",
            "desc": "Insert a blank region into an image at the specified position. Image "
                "dimensions increase by the region size.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSpliceRequestDataType::Fields{"width", "height", "x", "y"}, {
