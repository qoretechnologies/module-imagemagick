            "output_type": ImageMagickSetPropertyDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": ImageMagickDataProvider::AppName,
            "path": "/image/set-profile",
            "action": "set-profile",
            "display_name": "Set Profile",
            "short_desc": "Set an image profile (ICC, IPTC, etc.)",
            "desc": "Set a binary image profile such as ICC color management, IPTC metadata, "
                "or XMP data",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSetProfileRequestDataType::Fields{"name", "profile_data"}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSetProfileRequestDataType::Fields{"location",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                ImageMagickSetProfileRequestDataType::Fields
                    - ("name", "profile_data", "location"),
            ),
            "output_type": ImageMagickSetProfileDataProvider::ResponseType,
