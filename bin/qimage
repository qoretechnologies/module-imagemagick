    # ── I/O Helpers ──────────────────────────────────────────────────────

    private MagickImage readInput(string path) {
        if (!is_readable(path)) {
            printf("%s cannot read file %y\n", color.error("ERROR:"), path);
            exit(1);
        }
        try {
            return new MagickImage(path);
        } catch (hash<ExceptionInfo> ex) {
            printf("%s failed to load %y: %s\n", color.error("ERROR:"), path, ex.desc);
            exit(1);
        }
    }

    private writeOutput(MagickImage img, string input_path) {
        *string output_path;
        if (opts.in_place) {
            output_path = input_path;
        } else if (opts.output) {
            output_path = opts.output;
        } else {
            printf("%s output required: use %s or %s\n", color.error("ERROR:"),
                color.key("-o <file>"), color.key("-i"));
            exit(1);
        }

        if (opts.fmt) {
            img.setFormat(opts.fmt);
        } else {
            # Infer format from output file extension
            *string ext = (output_path =~ x/\.([^.]+)$/)[0];
            if (ext) {
                img.setFormat(ext.upr());
            }
        }
        if (opts.quality) {
            img.setCompressionQuality(opts.quality);
        }

        try {
            img.writeFile(output_path);
        } catch (hash<ExceptionInfo> ex) {
            printf("%s failed to write %y: %s\n", color.error("ERROR:"), output_path, ex.desc);
            exit(1);
        }

        if ((opts.verbose ?? 0) > 0) {
            hash<ImageInfo> info = img.getInfo();
            printf("%s %s (%sx%s %s)\n", color.success("Wrote"), color.key(output_path),
                color.number(sprintf("%d", info.width)), color.number(sprintf("%d", info.height)),
                color.type(info.format));
        }
    }

    private requireOutput() {
        if (!opts.output && !opts.in_place) {
            printf("%s %s requires %s or %s\n", color.error("ERROR:"), command,
                color.key("-o <file>"), color.key("-i"));
            printf("\n  Usage: qimage %s <input> -o <output> [options]\n", command);
            exit(1);
        }
    }

    private string requireArg(string name) {
        *string arg = shift ARGV;
        if (!arg) {
            printf("%s %s requires %s argument\n", color.error("ERROR:"), command, name);
            printf("\n  Run %s for usage\n", color.key(sprintf("qimage %s --help", command)));
            exit(1);
        }
        return arg;
    }

    private float requireFloat(string name, *float val) {
        if (!exists val) {
            printf("%s %s requires %s\n", color.error("ERROR:"), command, color.key("--" + name));
            exit(1);
        }
        return val;
    }

    private int requireInt(string name, *int val) {
        if (!exists val) {
            printf("%s %s requires %s\n", color.error("ERROR:"), command, color.key("--" + name));
            exit(1);
        }
        return val;
    }

    private string requireString(string name, *string val) {
        if (!exists val) {
            printf("%s %s requires %s\n", color.error("ERROR:"), command, color.key("--" + name));
            exit(1);
        }
        return val;
    }

    # ── Tier 1: Standalone Commands ──────────────────────────────────────

    private doFonts() {
        string pattern = ARGV[0] ?? "*";
        list<string> fonts = MagickImage::queryFonts(pattern);
        if (!fonts) {
            printf("%s no fonts matching %y\n", color.warning("WARNING:"), pattern);
            return;
        }

        printf("%s (%s)\n\n", color.bold("Available Fonts"),
            color.number(sprintf("%d", fonts.size())));

        foreach string font in (fonts) {
            printf("  %s\n", color.value(font));
        }
    }

    private doFormats() {
        string pattern = ARGV[0] ?? "*";
        list<string> formats = MagickImage::queryFormats(pattern);
        if (!formats) {
            printf("%s no formats matching %y\n", color.warning("WARNING:"), pattern);
            return;
        }

        printf("%s (%s)\n\n", color.bold("Supported Formats"),
            color.number(sprintf("%d", formats.size())));

        # Display in columns
        int max_len = 0;
        foreach string fmt in (formats) {
            if (fmt.length() > max_len) {
                max_len = fmt.length();
            }
        }
        int col_width = max_len + 2;
        int cols = 80 / col_width;
        if (cols < 1) {
            cols = 1;
        }

        int i = 0;
        foreach string fmt in (formats) {
            printf("  %s", color.type(sprintf("%-" + sprintf("%d", col_width) + "s", fmt)));
            if ((++i % cols) == 0) {
                printf("\n");
            }
        }
        if (i % cols) {
            printf("\n");
        }
    }

    # ── Tier 2: Read-only Commands ───────────────────────────────────────

    private doInfo() {
        string path = requireArg("<file>");
        MagickImage img = readInput(path);
        hash<ImageInfo> info = img.getInfo();

        printf("%s %s\n\n", color.bold("Image:"), color.key(path));

        printf("  %s  %s x %s pixels\n", color.key(sprintf("%-18s", "Dimensions:")),
            color.number(sprintf("%d", info.width)),
            color.number(sprintf("%d", info.height)));
        printf("  %s  %s\n", color.key(sprintf("%-18s", "Format:")),
            color.type(info.format));
        printf("  %s  %s\n", color.key(sprintf("%-18s", "Colorspace:")),
            color.value(info.colorspace));
        printf("  %s  %s\n", color.key(sprintf("%-18s", "Type:")),
            color.value(info.image_type));
        printf("  %s  %s bits/channel\n", color.key(sprintf("%-18s", "Depth:")),
            color.number(sprintf("%d", info.depth)));
        printf("  %s  %s x %s DPI\n", color.key(sprintf("%-18s", "Resolution:")),
            color.number(sprintf("%.1f", info.resolution.x)),
            color.number(sprintf("%.1f", info.resolution.y)));
        if (info.compression_quality > 0) {
            printf("  %s  %s\n", color.key(sprintf("%-18s", "Quality:")),
                color.number(sprintf("%d", info.compression_quality)));
        }
        printf("  %s  %s\n", color.key(sprintf("%-18s", "Colors:")),
            color.number(sprintf("%d", info.colors)));
        if (info.number_images > 1) {
            printf("  %s  %s\n", color.key(sprintf("%-18s", "Images:")),
                color.number(sprintf("%d", info.number_images)));
        }
        printf("  %s  %s\n", color.key(sprintf("%-18s", "Signature:")),
            color.dim(info.signature));

        if ((opts.verbose ?? 0) > 0) {
            hash<auto> props = img.getProperties("*");
            if (props) {
                printf("\n%s\n", color.bold("Properties:"));
                foreach hash<auto> pair in (props.pairIterator()) {
                    printf("  %s  %s\n", color.key(sprintf("%-35s", pair.key + ":")),
                        color.value(pair.value.toString()));
                }
            }
        }
    }

    private doIdentify() {
        string path = requireArg("<file>");
        MagickImage img = readInput(path);
        string ident = img.identify();

        # Colorize key: value lines
        list<string> lines = ident.split("\n");
        foreach string line in (lines) {
            if (*list<string> parts = (line =~ x/^(\s*)([\w\s\-]+):\s*(.*)$/)) {
                printf("%s%s: %s\n", parts[0], color.key(parts[1]), color.value(parts[2]));
            } else {
                printf("%s\n", line);
            }
        }
    }

    private doProps() {
        string path = requireArg("<file>");
        MagickImage img = readInput(path);

        if (opts.set) {
            doPropsSet(img, path);
        } else if (opts.del) {
            doPropsDel(img, path);
        } else {
            doPropsGet(img);
        }
    }

    private doPropsSet(MagickImage img, string path) {
        if (!opts.output && !opts.in_place) {
            printf("%s --set requires %s or %s\n", color.error("ERROR:"),
                color.key("-o <file>"), color.key("-i"));
            exit(1);
        }
        *list<string> parts = (opts.set =~ x/^([^=]+)=(.*)$/);
        if (!parts) {
            printf("%s --set format must be %s\n", color.error("ERROR:"),
                color.key("name=value"));
            exit(1);
        }
        img.setProperty(parts[0], parts[1]);
        writeOutput(img, path);
        printf("%s set property %s = %s\n", color.success("OK:"),
            color.key(parts[0]), color.value(parts[1]));
    }

    private doPropsDel(MagickImage img, string path) {
        if (!opts.output && !opts.in_place) {
            printf("%s --delete requires %s or %s\n", color.error("ERROR:"),
                color.key("-o <file>"), color.key("-i"));
            exit(1);
        }
        img.deleteProperty(opts.del);
        writeOutput(img, path);
        printf("%s deleted property %s\n", color.success("OK:"), color.key(opts.del));
    }

    private doPropsGet(MagickImage img) {
        string pattern = opts.get ?? "*";
        hash<auto> props = img.getProperties(pattern);
        if (!props) {
            printf("%s no properties matching %y\n", color.warning("WARNING:"), pattern);
            return;
        }
        printf("%s (%s)\n\n", color.bold("Properties"),
            color.number(sprintf("%d", props.size())));
        foreach hash<auto> pair in (props.pairIterator()) {
            printf("  %s  %s\n", color.key(sprintf("%-35s", pair.key + ":")),
                color.value(pair.value.toString()));
        }
    }

    private doProfile() {
        string path = requireArg("<file>");
        MagickImage img = readInput(path);

        if (opts.set) {
            doProfileSet(img, path);
        } else if (opts.extr) {
            doProfileExtract(img);
        } else if (opts.get) {
            doProfileGet(img);
        } else {
            doProfileList(img);
        }
    }

    private doProfileSet(MagickImage img, string path) {
        if (!opts.output && !opts.in_place) {
            printf("%s --set requires %s or %s\n", color.error("ERROR:"),
                color.key("-o <file>"), color.key("-i"));
            exit(1);
        }
        *list<string> parts = (opts.set =~ x/^([^=]+)=(.*)$/);
        if (!parts) {
            printf("%s --set format must be %s\n", color.error("ERROR:"),
                color.key("name=file"));
            exit(1);
        }
        binary data;
        try {
            data = ReadOnlyFile::readBinaryFile(parts[1]);
        } catch (hash<ExceptionInfo> ex) {
            printf("%s failed to read %y: %s\n", color.error("ERROR:"), parts[1], ex.desc);
            exit(1);
        }
        img.setProfile(parts[0], data);
        writeOutput(img, path);
        printf("%s set profile %s from %s (%s bytes)\n", color.success("OK:"),
            color.key(parts[0]), color.value(parts[1]),
            color.number(sprintf("%d", data.size())));
    }

    private doProfileExtract(MagickImage img) {
        *list<string> parts = (opts.extr =~ x/^([^=]+)=(.*)$/);
        if (!parts) {
            printf("%s --extract format must be %s\n", color.error("ERROR:"),
                color.key("name=file"));
            exit(1);
        }
        *binary data = img.getProfile(parts[0]);
        if (!data) {
            printf("%s no %s profile found\n", color.error("ERROR:"), parts[0]);
            exit(1);
        }
        try {
            File f();
            f.open2(parts[1], O_CREAT | O_TRUNC | O_WRONLY);
            f.write(data);
        } catch (hash<ExceptionInfo> ex) {
            printf("%s failed to write %y: %s\n", color.error("ERROR:"), parts[1], ex.desc);
            exit(1);
        }
        printf("%s extracted %s profile to %s (%s bytes)\n", color.success("OK:"),
            color.key(parts[0]), color.value(parts[1]),
            color.number(sprintf("%d", data.size())));
    }

    private doProfileGet(MagickImage img) {
        *binary data = img.getProfile(opts.get);
        if (!data) {
            printf("%s no %s profile found\n", color.warning("WARNING:"), opts.get);
            return;
        }
        printf("%s %s (%s bytes)\n", color.bold("Profile:"), color.key(opts.get),
            color.number(sprintf("%d", data.size())));
    }

    private doProfileList(MagickImage img) {
        list<string> names = img.getProfileNames();
        if (!names) {
            printf("%s no profiles found\n", color.dim("(none)"));
            return;
        }
        printf("%s (%s)\n\n", color.bold("Profiles"),
            color.number(sprintf("%d", names.size())));
        foreach string name in (names) {
            *binary pdata = img.getProfile(name);
            printf("  %s  %s\n", color.key(sprintf("%-12s", name)),
                pdata ? color.number(sprintf("%d bytes", pdata.size())) : color.dim("empty"));
        }
    }

    private doPixel() {
        string path = requireArg("<file>");
        MagickImage img = readInput(path);

        if (opts.set) {
            doPixelSet(img, path);
        } else if (opts.get) {
            doPixelGet(img);
        } else {
            printf("%s pixel requires %s or %s\n", color.error("ERROR:"),
                color.key("--get <x,y>"), color.key("--set <x,y=color>"));
            exit(1);
        }
    }

    private doPixelSet(MagickImage img, string path) {
        if (!opts.output && !opts.in_place) {
            printf("%s --set requires %s or %s\n", color.error("ERROR:"),
                color.key("-o <file>"), color.key("-i"));
            exit(1);
        }
        *list<string> parts = (opts.set =~ x/^(\d+),(\d+)=(.+)$/);
        if (!parts) {
            printf("%s --set format must be %s\n", color.error("ERROR:"),
                color.key("x,y=color"));
            exit(1);
        }
        img.setPixelColor(parts[0].toInt(), parts[1].toInt(), parts[2]);
        writeOutput(img, path);
        printf("%s set pixel (%s,%s) = %s\n", color.success("OK:"),
            color.number(parts[0]), color.number(parts[1]), color.value(parts[2]));
    }

    private doPixelGet(MagickImage img) {
        *list<string> parts = (opts.get =~ x/^(\d+),(\d+)$/);
        if (!parts) {
            printf("%s --get format must be %s\n", color.error("ERROR:"),
                color.key("x,y"));
            exit(1);
        }
        string pixel_color = img.getPixelColor(parts[0].toInt(), parts[1].toInt());
        printf("%s (%s,%s) = %s\n", color.bold("Pixel"),
            color.number(parts[0]), color.number(parts[1]), color.value(pixel_color));
    }

    # ── Tier 3: Transform Commands ───────────────────────────────────────

    private doConvert() {
        string path = requireArg("<input>");
        requireOutput();
        MagickImage img = readInput(path);

        if (opts.depth) {
            img.setDepth(opts.depth);
        }

        writeOutput(img, path);
    }

    private doResize() {
        string path = requireArg("<input>");
        requireOutput();
        MagickImage img = readInput(path);

        string method = opts.method ?? "resize";

        switch (method) {
            case "resize": {
                int w = requireInt("width", opts.width);
                int h = requireInt("height", opts.height);
                string filter = opts.filter ?? "Lanczos";
                img.resize(w, h, filter);
                break;
            }
            case "scale": {
                int w = requireInt("width", opts.width);
                int h = requireInt("height", opts.height);
                img.scale(w, h);
                break;
            }
            case "thumbnail": {
                int w = requireInt("width", opts.width);
                int h = requireInt("height", opts.height);
                img.thumbnail(w, h);
                break;
            }
            case "adaptive": {
                int w = requireInt("width", opts.width);
                int h = requireInt("height", opts.height);
                img.adaptiveResize(w, h);
                break;
            }
            case "sample": {
                int w = requireInt("width", opts.width);
                int h = requireInt("height", opts.height);
                img.sample(w, h);
                break;
            }
            case "liquid": {
                int w = requireInt("width", opts.width);
                int h = requireInt("height", opts.height);
                float dx = opts.delta_x ?? 0.0;
                float rig = opts.rigidity ?? 0.0;
                img.liquidRescale(w, h, dx, rig);
                break;
            }
            case "resample": {
                float dx = requireFloat("dpi-x", opts.dpi_x);
                float dy = requireFloat("dpi-y", opts.dpi_y);
                string filter = opts.filter ?? "Lanczos";
                img.resample(dx, dy, filter);
                break;
            }
            default:
                printf("%s unknown resize method %y\n", color.error("ERROR:"), method);
                printf("  Valid methods: %s\n",
                    color.value("resize, scale, thumbnail, adaptive, sample, liquid, resample"));
                exit(1);
        }

        writeOutput(img, path);
    }

    private doCrop() {
        string path = requireArg("<input>");
        requireOutput();
        MagickImage img = readInput(path);

        string method = opts.method ?? "crop";

        switch (method) {
            case "crop": {
                int w = requireInt("width", opts.width);
                int h = requireInt("height", opts.height);
                int cx = opts.x ?? 0;
                int cy = opts.y ?? 0;
                img.crop(w, h, cx, cy);
                break;
            }
            case "trim": {
                float fuzz = opts.fuzz ?? 0.0;
                img.trim(fuzz);
                break;
            }
            case "extent": {
                int w = requireInt("width", opts.width);
                int h = requireInt("height", opts.height);
                int cx = opts.x ?? 0;
                int cy = opts.y ?? 0;
                img.extent(w, h, cx, cy);
                break;
            }
            case "chop": {
                int w = requireInt("width", opts.width);
                int h = requireInt("height", opts.height);
                int cx = requireInt("x", opts.x);
                int cy = requireInt("y", opts.y);
                img.chop(w, h, cx, cy);
                break;
            }
            case "shave": {
                int c = requireInt("columns", opts.columns);
                int r = requireInt("rows", opts.rows);
                img.shave(c, r);
                break;
            }
            case "splice": {
                int w = requireInt("width", opts.width);
                int h = requireInt("height", opts.height);
                int cx = requireInt("x", opts.x);
                int cy = requireInt("y", opts.y);
                img.splice(w, h, cx, cy);
                break;
            }
            default:
                printf("%s unknown crop method %y\n", color.error("ERROR:"), method);
                printf("  Valid methods: %s\n",
                    color.value("crop, trim, extent, chop, shave, splice"));
                exit(1);
        }

        writeOutput(img, path);
    }

    private doRotate() {
        string path = requireArg("<input>");
        requireOutput();
        MagickImage img = readInput(path);

        string method = opts.method ?? "rotate";

        switch (method) {
            case "rotate": {
                float deg = requireFloat("degrees", opts.degrees);
                string bg = opts.background ?? "white";
                img.rotate(deg, bg);
                break;
            }
            case "flip": {
                string dir = opts.direction ?? "v";
                if (dir == "v" || dir == "vertical") {
                    img.flip();
                } else if (dir == "h" || dir == "horizontal") {
                    img.flop();
                } else {
                    printf("%s --direction must be %s or %s\n", color.error("ERROR:"),
                        color.value("v"), color.value("h"));
                    exit(1);
                }
                break;
            }
            case "transpose":
                img.transpose();
                break;
            case "transverse":
                img.transverse();
                break;
            case "auto-orient":
                img.autoOrient();
                break;
            case "deskew": {
                float thr = requireFloat("threshold", opts.threshold);
                img.deskew(thr);
                break;
            }
            case "shear": {
                float sx = requireFloat("shear-x", opts.shear_x);
                float sy = requireFloat("shear-y", opts.shear_y);
                string bg = opts.background ?? "white";
                img.shear(sx, sy, bg);
                break;
            }
            default:
                printf("%s unknown rotate method %y\n", color.error("ERROR:"), method);
                printf("  Valid methods: %s\n",
                    color.value("rotate, flip, transpose, transverse, auto-orient, deskew, shear"));
                exit(1);
        }

        writeOutput(img, path);
    }

    private doAdjust() {
        string path = requireArg("<input>");
        requireOutput();
        MagickImage img = readInput(path);

        string method = opts.method ?? "brightness-contrast";

        switch (method) {
            case "brightness-contrast": {
                float b = opts.brightness ?? 0.0;
                float c = opts.contrast ?? 0.0;
                img.brightnessContrast(b, c);
                break;
            }
            case "gamma": {
                float g = requireFloat("gamma", opts.gamma);
                img.gamma(g);
                break;
            }
            case "level": {
                float bp = requireFloat("black-point", opts.black_point);
                float g = requireFloat("gamma", opts.gamma);
                float wp = requireFloat("white-point", opts.white_point);
                img.level(bp, g, wp);
                break;
            }
            case "modulate": {
                float b = opts.brightness ?? 100.0;
                float s = opts.saturation ?? 100.0;
                float h = opts.hue ?? 100.0;
                img.modulate(b, s, h);
                break;
            }
            case "negate":
                img.negate(opts.gray ?? False);
                break;
            case "normalize":
                img.normalize();
                break;
            case "equalize":
                img.equalize();
                break;
            case "auto-gamma":
                img.autoGamma();
                break;
            case "auto-level":
                img.autoLevel();
                break;
            case "sigmoidal-contrast": {
                float str = requireFloat("strength", opts.strength);
                float mp = requireFloat("midpoint", opts.midpoint);
                bool sharpen = opts.sharpen_flag ?? True;
                img.sigmoidalContrast(sharpen, str, mp);
                break;
            }
            case "contrast-stretch": {
                float bp = requireFloat("black-point", opts.black_point);
                float wp = requireFloat("white-point", opts.white_point);
                img.contrastStretch(bp, wp);
                break;
            }
            case "linear-stretch": {
                float bp = requireFloat("black-point", opts.black_point);
                float wp = requireFloat("white-point", opts.white_point);
                img.linearStretch(bp, wp);
                break;
            }
            case "enhance":
                img.enhance();
                break;
            case "white-balance":
                img.whiteBalance();
                break;
            case "colorspace": {
                string cs = requireString("colorspace", opts.colorspace);
                img.transformColorspace(cs);
                break;
            }
            default:
                printf("%s unknown adjust method %y\n", color.error("ERROR:"), method);
                printf("  Valid methods: %s\n", color.value("brightness-contrast, gamma, level, "
                    "modulate, negate, normalize, equalize, auto-gamma, auto-level, "
                    "sigmoidal-contrast, contrast-stretch, linear-stretch, enhance, "
                    "white-balance, colorspace"));
                exit(1);
        }

        writeOutput(img, path);
    }

    private doBlur() {
        string path = requireArg("<input>");
        requireOutput();
        MagickImage img = readInput(path);

        string method = opts.method ?? "blur";

        switch (method) {
            case "blur": {
                float r = requireFloat("radius", opts.radius);
