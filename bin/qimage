    "hue":          "hue=f",
    "saturation":   "saturation=f",
    "colorspace":   "colorspace=s",
    "strength":     "strength=f",
    "midpoint":     "midpoint=f",
    "sharpen_flag": "sharpen",

    # Blur/Sharpen/Effects
    "radius":       "radius=f",
    "sigma":        "sigma=f",
    "angle":        "angle=f",
    "gain":         "gain=f",
    "threshold":    "threshold=f",

    # Effects
    "amplitude":    "amplitude=f",
    "wavelength":   "wavelength=f",
    "amount":       "amount=f",
    "alpha":        "alpha=f",
    "azimuth":      "azimuth=f",
    "elevation":    "elevation=f",
    "levels":       "levels=i",
    "dither":       "dither",
    "gray":         "gray",
    "factor":       "factor=f",

    # Noise
    "noise_type":   "type=s",
    "attenuate":    "attenuate=f",
