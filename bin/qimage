%modern

%requires imagemagick
%requires Util

%try-module yaml
%define NoYaml
%endtry

%try-module json
%define NoJson
%endtry

%exec-class QImageMain

const VERSION = "1.0";

const Opts = {
    # Global
    "output":       "o,output=s",
    "in_place":     "i,in-place",
    "quality":      "q,quality=i",
    "fmt":          "F,format=s",
    "nocolor":      "C,no-color",
    "verbose":      "v,verbose:i+",
    "help":         "h,help",
    "version":      "V,version",

    # Common transform
    "method":       "m,method=s",
    "width":        "width=i",
    "height":       "height=i",
    "x":            "x-pos,x=i",
    "y":            "y-pos,y=i",

    # Resize
    "filter":       "filter=s",
    "delta_x":      "delta-x=f",
    "rigidity":     "rigidity=f",
    "dpi_x":        "dpi-x=f",
    "dpi_y":        "dpi-y=f",

    # Crop
    "fuzz":         "fuzz=f",
    "columns":      "columns=i",
