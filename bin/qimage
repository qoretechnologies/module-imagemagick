    # Convert
    "depth":        "depth=i",
};

#! All valid commands
const Commands = {
    "info": "Show image metadata",
    "identify": "Full verbose identification",
    "convert": "Convert image format",
    "resize": "Resize image",
    "crop": "Crop/trim image",
    "rotate": "Rotate/flip/orient image",
    "adjust": "Color/brightness adjustments",
    "blur": "Blur operations",
    "sharpen": "Sharpen operations",
    "effect": "Visual effects",
    "noise": "Noise add/remove",
    "composite": "Composite images",
    "annotate": "Add text annotation",
    "draw": "Draw shapes and text from commands",
    "border": "Add border or frame",
    "strip": "Strip all metadata",
    "props": "Get/set image properties",
    "profile": "Manage ICC/EXIF/IPTC profiles",
    "pixel": "Get/set pixel colors",
    "fonts": "List available fonts",
    "formats": "List supported formats",
};

#! Commands that require an output file
const TransformCommands = {
    "convert": True,
    "resize": True,
    "crop": True,
    "rotate": True,
    "adjust": True,
    "blur": True,
    "sharpen": True,
    "effect": True,
    "noise": True,
    "composite": True,
    "annotate": True,
    "draw": True,
    "border": True,
    "strip": True,
};

class QImageMain {
    private {
        hash<auto> opts;
        *string command;
        Util::TerminalColor color;
    }

    constructor() {
        GetOpt getopt(Opts);
        opts = getopt.parse3(\ARGV);

        color = new Util::TerminalColor(!opts.nocolor);

        if (opts.help && !ARGV) {
            doHelp(0);
        }
        if (opts.version) {
            printf("qimage v%s\n", VERSION);
            exit(0);
        }

        if (!ARGV) {
            doHelp();
        }

        command = shift ARGV;

        if (!Commands{command}) {
            printf("%s unknown command %y\n\n", color.error("ERROR:"), command);
            doHelp();
        }

        if (opts.help) {
            doCommandHelp();
            exit(0);
        }

        switch (command) {
            case "fonts": doFonts(); break;
            case "formats": doFormats(); break;
            case "info": doInfo(); break;
            case "identify": doIdentify(); break;
            case "props": doProps(); break;
            case "profile": doProfile(); break;
            case "pixel": doPixel(); break;
            case "convert": doConvert(); break;
            case "resize": doResize(); break;
            case "crop": doCrop(); break;
            case "rotate": doRotate(); break;
            case "adjust": doAdjust(); break;
            case "blur": doBlur(); break;
            case "sharpen": doSharpen(); break;
            case "effect": doEffect(); break;
            case "noise": doNoise(); break;
            case "composite": doComposite(); break;
            case "annotate": doAnnotate(); break;
            case "draw": doDraw(); break;
            case "border": doBorder(); break;
            case "strip": doStrip(); break;
        }
    }

    # ── Help ─────────────────────────────────────────────────────────────

    private doHelp(int exit_code = 1) {
        printf("%s v%s - ImageMagick image processing tool for Qore\n\n", color.bold("qimage"), VERSION);

        printf("%s\n", color.bold("Usage:"));
        printf("  qimage <command> [options] [arguments]\n");

        printf("\n%s\n", color.bold("Query Commands:"));
        printf("  %s           List available fonts\n", color.key("fonts"));
        printf("  %s         List supported image formats\n", color.key("formats"));

        printf("\n%s\n", color.bold("Info Commands:"));
        printf("  %s            Show image metadata summary\n", color.key("info"));
        printf("  %s        Full verbose identification\n", color.key("identify"));
        printf("  %s           Get/set image properties\n", color.key("props"));
        printf("  %s         Manage ICC/EXIF/IPTC profiles\n", color.key("profile"));
        printf("  %s           Get/set pixel colors\n", color.key("pixel"));

        printf("\n%s\n", color.bold("Transform Commands:"));
        printf("  %s         Convert image format\n", color.key("convert"));
        printf("  %s          Resize image\n", color.key("resize"));
        printf("  %s            Crop/trim image\n", color.key("crop"));
        printf("  %s          Rotate/flip/orient image\n", color.key("rotate"));
        printf("  %s          Color/brightness adjustments\n", color.key("adjust"));
        printf("  %s            Blur operations\n", color.key("blur"));
        printf("  %s         Sharpen operations\n", color.key("sharpen"));
        printf("  %s          Visual effects\n", color.key("effect"));
        printf("  %s           Noise add/remove\n", color.key("noise"));
        printf("  %s       Composite images\n", color.key("composite"));
        printf("  %s        Add text annotation\n", color.key("annotate"));
        printf("  %s            Draw shapes/text from YAML/JSON commands\n", color.key("draw"));
        printf("  %s          Add border or frame\n", color.key("border"));
        printf("  %s           Strip all metadata\n", color.key("strip"));

        printf("\n%s\n", color.bold("Global Options:"));
        printf("  %s        Output file %s\n", color.key("-o, --output <file>"),
            color.dim("(transform commands)"));
        printf("  %s             Modify input file in place\n", color.key("-i, --in-place"));
        printf("  %s         Output quality %s\n", color.key("-q, --quality <0-100>"),
            color.dim("(0-100)"));
        printf("  %s         Output format override\n", color.key("-F, --format <fmt>"));
        printf("  %s             Disable color output\n", color.key("-C, --no-color"));
        printf("  %s              Increase verbosity\n", color.key("-v, --verbose"));
        printf("  %s                 Show help %s\n", color.key("-h, --help"),
            color.dim("(use with command for details)"));
        printf("  %s              Show version\n", color.key("-V, --version"));

        printf("\n%s\n", color.bold("Examples:"));
        printf("  %s\n", color.dim("# Get image info:"));
        printf("  qimage info photo.jpg\n");
        printf("  %s\n", color.dim("# Resize to 800x600:"));
        printf("  qimage resize photo.jpg -o thumb.jpg --width 800 --height 600\n");
        printf("  %s\n", color.dim("# Apply sepia effect:"));
        printf("  qimage effect photo.jpg -o sepia.jpg --method sepia --threshold 80\n");
        printf("  %s\n", color.dim("# Convert to WebP:"));
        printf("  qimage convert photo.jpg -o photo.webp --quality 85\n");
        printf("  %s\n", color.dim("# List fonts:"));
        printf("  qimage fonts\n");
        exit(exit_code);
    }

    private doCommandHelp() {
        switch (command) {
            case "fonts":
                printf("%s\n", color.bold("qimage fonts [pattern]"));
                printf("\nList available fonts. Optionally filter by glob pattern.\n");
                printf("\n%s\n", color.bold("Examples:"));
                printf("  qimage fonts\n");
                printf("  qimage fonts \"Helvetica*\"\n");
                break;

            case "formats":
                printf("%s\n", color.bold("qimage formats [pattern]"));
                printf("\nList supported image formats. Optionally filter by glob pattern.\n");
                printf("\n%s\n", color.bold("Examples:"));
                printf("  qimage formats\n");
                printf("  qimage formats \"PNG*\"\n");
                break;

            case "info":
                printf("%s\n", color.bold("qimage info <file> [-v]"));
                printf("\nShow image metadata: dimensions, format, colorspace, depth, resolution,\n");
                printf("quality, colors, and signature. Use -v to include EXIF properties.\n");
                printf("\n%s\n", color.bold("Examples:"));
                printf("  qimage info photo.jpg\n");
                printf("  qimage info photo.jpg -v\n");
                break;

            case "identify":
                printf("%s\n", color.bold("qimage identify <file>"));
                printf("\nDisplay full verbose identification output from ImageMagick.\n");
                printf("\n%s\n", color.bold("Examples:"));
                printf("  qimage identify photo.jpg\n");
                break;

            case "convert":
                printf("%s\n", color.bold("qimage convert <input> -o <output> [options]"));
                printf("\nConvert image format. The output format is determined by the file extension\n");
                printf("or the --format flag.\n");
                printf("\n%s\n", color.bold("Options:"));
                printf("  %s     Output format %s\n", color.key("--format <fmt>"),
                    color.dim("(png, jpeg, webp, tiff, ...)"));
                printf("  %s   Output quality %s\n", color.key("--quality <0-100>"),
                    color.dim("(0-100)"));
                printf("  %s      Bit depth %s\n", color.key("--depth <n>"),
                    color.dim("(8, 16, or 32)"));
                printf("\n%s\n", color.bold("Examples:"));
                printf("  qimage convert photo.jpg -o photo.webp\n");
                printf("  qimage convert photo.png -o photo.jpg --quality 90\n");
                printf("  qimage convert photo.jpg -o photo.tiff --depth 16\n");
                break;

            case "resize":
                printf("%s\n", color.bold("qimage resize <input> -o <output> [options]"));
                printf("\n%s\n", color.bold("Methods:"));
                printf("  %s     High-quality resize with filter %s\n",
                    color.key("resize"), color.dim("(default)"));
                printf("  %s      Fast scaling without filtering\n", color.key("scale"));
                printf("  %s  Optimized thumbnail generation\n", color.key("thumbnail"));
                printf("  %s   Data-dependent triangulation\n", color.key("adaptive"));
                printf("  %s     Pixel sampling %s\n", color.key("sample"),
                    color.dim("(fastest, no interpolation)"));
                printf("  %s     Content-aware seam carving\n", color.key("liquid"));
                printf("  %s   Change image resolution %s\n", color.key("resample"),
                    color.dim("(DPI)"));
                printf("\n%s\n", color.bold("Options:"));
                printf("  %s        Target width in pixels\n", color.key("--width <n>"));
                printf("  %s       Target height in pixels\n", color.key("--height <n>"));
                printf("  %s   Resize filter %s\n", color.key("--filter <name>"),
                    color.dim("(Lanczos, Mitchell, Catrom, Gaussian, Box, ...)"));
                printf("  %s    Delta X for liquid rescale\n", color.key("--delta-x <f>"));
                printf("  %s  Rigidity for liquid rescale\n", color.key("--rigidity <f>"));
                printf("  %s      Target X DPI %s\n", color.key("--dpi-x <f>"),
                    color.dim("(resample method)"));
                printf("  %s      Target Y DPI %s\n", color.key("--dpi-y <f>"),
                    color.dim("(resample method)"));
                printf("\n%s\n", color.bold("Examples:"));
                printf("  qimage resize photo.jpg -o small.jpg --width 800 --height 600\n");
                printf("  qimage resize photo.jpg -o thumb.jpg -m thumbnail --width 200 --height 200\n");
                printf("  qimage resize photo.jpg -o fast.jpg -m scale --width 400 --height 300\n");
                printf("  qimage resize photo.jpg -o liquid.jpg -m liquid --width 600 --height 400\n");
                printf("  qimage resize photo.jpg -o hires.jpg -m resample --dpi-x 300 --dpi-y 300\n");
                break;

            case "crop":
                printf("%s\n", color.bold("qimage crop <input> -o <output> [options]"));
                printf("\n%s\n", color.bold("Methods:"));
                printf("  %s       Crop rectangular region %s\n",
                    color.key("crop"), color.dim("(default)"));
                printf("  %s       Auto-trim uniform edges\n", color.key("trim"));
                printf("  %s     Set canvas size and position\n", color.key("extent"));
                printf("  %s       Remove rectangular region\n", color.key("chop"));
                printf("  %s      Remove pixels from edges\n", color.key("shave"));
                printf("  %s     Insert blank region\n", color.key("splice"));
                printf("\n%s\n", color.bold("Options:"));
                printf("  %s        Region width\n", color.key("--width <n>"));
                printf("  %s       Region height\n", color.key("--height <n>"));
                printf("  %s            X offset\n", color.key("-x <n>"));
                printf("  %s            Y offset\n", color.key("-y <n>"));
                printf("  %s       Color similarity tolerance %s\n", color.key("--fuzz <f>"),
                    color.dim("(trim method)"));
                printf("  %s    Columns to shave %s\n", color.key("--columns <n>"),
                    color.dim("(shave method)"));
                printf("  %s       Rows to shave %s\n", color.key("--rows <n>"),
                    color.dim("(shave method)"));
                printf("\n%s\n", color.bold("Examples:"));
                printf("  qimage crop photo.jpg -o cropped.jpg --width 400 --height 300 --x 100 --y 50\n");
                printf("  qimage crop photo.jpg -o trimmed.jpg -m trim --fuzz 10\n");
                printf("  qimage crop photo.jpg -o canvas.jpg -m extent --width 1000 --height 800\n");
                printf("  qimage crop photo.jpg -o shaved.jpg -m shave --columns 20 --rows 20\n");
                break;

            case "rotate":
                printf("%s\n", color.bold("qimage rotate <input> -o <output> [options]"));
                printf("\n%s\n", color.bold("Methods:"));
                printf("  %s         Rotate by degrees %s\n",
                    color.key("rotate"), color.dim("(default)"));
                printf("  %s           Flip vertically or horizontally\n", color.key("flip"));
                printf("  %s      Mirror on top-left to bottom-right diagonal\n",
                    color.key("transpose"));
                printf("  %s     Mirror on top-right to bottom-left diagonal\n",
                    color.key("transverse"));
                printf("  %s    Auto-orient by EXIF tag\n", color.key("auto-orient"));
                printf("  %s         Remove skew from scanned images\n", color.key("deskew"));
                printf("  %s          Shear transform\n", color.key("shear"));
                printf("\n%s\n", color.bold("Options:"));
                printf("  %s     Rotation angle %s\n", color.key("--degrees <f>"),
                    color.dim("(rotate method)"));
                printf("  %s  Background color %s\n", color.key("--background <color>"),
                    color.dim("(default: white)"));
                printf("  %s  Flip direction %s\n", color.key("--direction <v|h>"),
                    color.dim("(v=vertical, h=horizontal)"));
                printf("  %s   Deskew threshold\n", color.key("--threshold <f>"));
                printf("  %s     X shear angle\n", color.key("--shear-x <f>"));
                printf("  %s     Y shear angle\n", color.key("--shear-y <f>"));
                printf("\n%s\n", color.bold("Examples:"));
                printf("  qimage rotate photo.jpg -o rotated.jpg --degrees 45\n");
                printf("  qimage rotate photo.jpg -o flipped.jpg -m flip --direction v\n");
                printf("  qimage rotate photo.jpg -i -m auto-orient\n");
                printf("  qimage rotate scan.jpg -o straight.jpg -m deskew --threshold 40\n");
                printf("  qimage rotate photo.jpg -o sheared.jpg -m shear --shear-x 10 --shear-y 0\n");
                break;

            case "adjust":
                printf("%s\n", color.bold("qimage adjust <input> -o <output> [options]"));
                printf("\n%s\n", color.bold("Methods:"));
                printf("  %s  Adjust brightness and contrast %s\n",
                    color.key("brightness-contrast"), color.dim("(default)"));
                printf("  %s                Gamma correction\n", color.key("gamma"));
                printf("  %s                Adjust levels (black/gamma/white)\n", color.key("level"));
                printf("  %s             Modulate brightness/saturation/hue\n", color.key("modulate"));
                printf("  %s               Invert colors\n", color.key("negate"));
                printf("  %s            Enhance contrast by normalizing\n", color.key("normalize"));
                printf("  %s             Equalize histogram\n", color.key("equalize"));
                printf("  %s           Automatic gamma correction\n", color.key("auto-gamma"));
                printf("  %s           Automatic level adjustment\n", color.key("auto-level"));
                printf("  %s  Sigmoidal contrast curve\n", color.key("sigmoidal-contrast"));
                printf("  %s     Stretch contrast range\n", color.key("contrast-stretch"));
                printf("  %s       Linear stretch contrast\n", color.key("linear-stretch"));
                printf("  %s              Digital filter enhancement\n", color.key("enhance"));
                printf("  %s        Auto white balance correction\n", color.key("white-balance"));
                printf("  %s           Change image colorspace\n", color.key("colorspace"));
                printf("\n%s\n", color.bold("Options:"));
                printf("  %s   Brightness value\n", color.key("--brightness <f>"));
                printf("  %s     Contrast value\n", color.key("--contrast <f>"));
                printf("  %s         Gamma value\n", color.key("--gamma <f>"));
                printf("  %s   Black point\n", color.key("--black-point <f>"));
                printf("  %s   White point\n", color.key("--white-point <f>"));
                printf("  %s           Hue rotation\n", color.key("--hue <f>"));
                printf("  %s    Saturation level\n", color.key("--saturation <f>"));
                printf("  %s  Colorspace name %s\n", color.key("--colorspace <name>"),
                    color.dim("(sRGB, CMYK, Gray, HSL, Lab, RGB)"));
                printf("  %s      Contrast strength\n", color.key("--strength <f>"));
                printf("  %s      Midpoint for sigmoidal\n", color.key("--midpoint <f>"));
                printf("  %s          Sharpen vs soften %s\n", color.key("--sharpen"),
                    color.dim("(sigmoidal-contrast)"));
                printf("\n%s\n", color.bold("Examples:"));
                printf("  qimage adjust photo.jpg -o bright.jpg --brightness 20 --contrast 10\n");
                printf("  qimage adjust photo.jpg -o corrected.jpg -m gamma --gamma 1.2\n");
                printf("  qimage adjust photo.jpg -o bw.jpg -m negate\n");
                printf("  qimage adjust photo.jpg -i -m white-balance\n");
                printf("  qimage adjust photo.jpg -o gray.jpg -m colorspace --colorspace Gray\n");
                break;

            case "blur":
                printf("%s\n", color.bold("qimage blur <input> -o <output> [options]"));
                printf("\n%s\n", color.bold("Methods:"));
                printf("  %s         Standard blur %s\n",
                    color.key("blur"), color.dim("(default)"));
                printf("  %s     Gaussian blur\n", color.key("gaussian"));
                printf("  %s     Adaptive blur %s\n", color.key("adaptive"),
                    color.dim("(edge-preserving)"));
                printf("  %s       Motion blur\n", color.key("motion"));
                printf("  %s    Selective blur %s\n", color.key("selective"),
                    color.dim("(threshold-based)"));
                printf("  %s   Rotational blur\n", color.key("rotational"));
                printf("\n%s\n", color.bold("Options:"));
                printf("  %s     Blur radius\n", color.key("--radius <f>"));
                printf("  %s      Blur sigma %s\n", color.key("--sigma <f>"),
                    color.dim("(standard deviation)"));
                printf("  %s      Angle in degrees %s\n", color.key("--angle <f>"),
                    color.dim("(motion/rotational)"));
                printf("  %s  Threshold %s\n", color.key("--threshold <f>"),
                    color.dim("(selective)"));
                printf("\n%s\n", color.bold("Examples:"));
                printf("  qimage blur photo.jpg -o blurred.jpg --radius 5 --sigma 2\n");
                printf("  qimage blur photo.jpg -o smooth.jpg -m gaussian --radius 3 --sigma 1.5\n");
                printf("  qimage blur photo.jpg -o motion.jpg -m motion --radius 10 --sigma 3 --angle 45\n");
                printf("  qimage blur photo.jpg -o spin.jpg -m rotational --angle 5\n");
                break;

            case "sharpen":
                printf("%s\n", color.bold("qimage sharpen <input> -o <output> [options]"));
                printf("\n%s\n", color.bold("Methods:"));
                printf("  %s        Standard sharpen %s\n",
                    color.key("sharpen"), color.dim("(default)"));
                printf("  %s       Adaptive sharpen %s\n", color.key("adaptive"),
                    color.dim("(edge-aware)"));
                printf("  %s   Unsharp mask %s\n", color.key("unsharp-mask"),
                    color.dim("(professional sharpening)"));
                printf("\n%s\n", color.bold("Options:"));
                printf("  %s     Sharpen radius\n", color.key("--radius <f>"));
                printf("  %s      Sharpen sigma\n", color.key("--sigma <f>"));
                printf("  %s       Gain amount %s\n", color.key("--gain <f>"),
                    color.dim("(unsharp-mask)"));
                printf("  %s  Threshold %s\n", color.key("--threshold <f>"),
                    color.dim("(unsharp-mask)"));
                printf("\n%s\n", color.bold("Examples:"));
                printf("  qimage sharpen photo.jpg -o sharp.jpg --radius 0 --sigma 1\n");
                printf("  qimage sharpen photo.jpg -o sharp.jpg -m unsharp-mask --radius 2 --sigma 1 --gain 1.5 --threshold 0.05\n");
                break;

            case "effect":
                printf("%s\n", color.bold("qimage effect <input> -o <output> --method <name> [options]"));
