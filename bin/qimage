                break;
            }
            case "gaussian": {
                float r = requireFloat("radius", opts.radius);
                float s = requireFloat("sigma", opts.sigma);
                img.gaussianBlur(r, s);
                break;
            }
            case "adaptive": {
                float r = requireFloat("radius", opts.radius);
                float s = requireFloat("sigma", opts.sigma);
                img.adaptiveBlur(r, s);
                break;
            }
            case "motion": {
                float r = requireFloat("radius", opts.radius);
                float s = requireFloat("sigma", opts.sigma);
                float a = requireFloat("angle", opts.angle);
                img.motionBlur(r, s, a);
                break;
            }
            case "selective": {
                float r = requireFloat("radius", opts.radius);
                float s = requireFloat("sigma", opts.sigma);
                float t = requireFloat("threshold", opts.threshold);
                img.selectiveBlur(r, s, t);
                break;
            }
            case "rotational": {
                float a = requireFloat("angle", opts.angle);
                img.rotationalBlur(a);
                break;
            }
            default:
                printf("%s unknown blur method %y\n", color.error("ERROR:"), method);
                printf("  Valid methods: %s\n",
                    color.value("blur, gaussian, adaptive, motion, selective, rotational"));
                exit(1);
        }

        writeOutput(img, path);
    }

    private doSharpen() {
        string path = requireArg("<input>");
        requireOutput();
        MagickImage img = readInput(path);

        string method = opts.method ?? "sharpen";

        switch (method) {
            case "sharpen": {
                float r = requireFloat("radius", opts.radius);
                float s = requireFloat("sigma", opts.sigma);
                img.sharpen(r, s);
                break;
            }
            case "adaptive": {
                float r = requireFloat("radius", opts.radius);
                float s = requireFloat("sigma", opts.sigma);
                img.adaptiveSharpen(r, s);
                break;
            }
            case "unsharp-mask": {
                float r = requireFloat("radius", opts.radius);
                float s = requireFloat("sigma", opts.sigma);
                float g = requireFloat("gain", opts.gain);
                float t = requireFloat("threshold", opts.threshold);
                img.unsharpMask(r, s, g, t);
                break;
            }
            default:
                printf("%s unknown sharpen method %y\n", color.error("ERROR:"), method);
                printf("  Valid methods: %s\n",
                    color.value("sharpen, adaptive, unsharp-mask"));
                exit(1);
        }

        writeOutput(img, path);
    }

    private doEffect() {
        string path = requireArg("<input>");
        requireOutput();
        MagickImage img = readInput(path);

        string method = requireString("method", opts.method);

        switch (method) {
            case "charcoal": {
                float r = requireFloat("radius", opts.radius);
                float s = requireFloat("sigma", opts.sigma);
                img.charcoal(r, s);
                break;
            }
            case "edge": {
                float r = requireFloat("radius", opts.radius);
                img.edge(r);
                break;
            }
            case "emboss": {
                float r = requireFloat("radius", opts.radius);
                float s = requireFloat("sigma", opts.sigma);
                img.emboss(r, s);
                break;
            }
            case "oil-paint": {
                float r = requireFloat("radius", opts.radius);
                float s = opts.sigma ?? 1.0;
                img.oilPaint(r, s);
                break;
            }
            case "sketch": {
                float r = requireFloat("radius", opts.radius);
                float s = requireFloat("sigma", opts.sigma);
                float a = requireFloat("angle", opts.angle);
                img.sketch(r, s, a);
                break;
            }
            case "solarize": {
                float t = requireFloat("threshold", opts.threshold);
                img.solarize(t);
                break;
            }
            case "sepia": {
                float t = requireFloat("threshold", opts.threshold);
                img.sepiaTone(t);
                break;
            }
            case "vignette": {
                float r = requireFloat("radius", opts.radius);
                float s = requireFloat("sigma", opts.sigma);
                int vx = opts.x ?? 0;
                int vy = opts.y ?? 0;
                img.vignette(r, s, vx, vy);
                break;
            }
            case "shadow": {
                float a = requireFloat("alpha", opts.alpha);
                float s = requireFloat("sigma", opts.sigma);
                int sx = opts.x ?? 0;
                int sy = opts.y ?? 0;
                img.shadow(a, s, sx, sy);
                break;
            }
            case "shade": {
                float az = requireFloat("azimuth", opts.azimuth);
                float el = requireFloat("elevation", opts.elevation);
                bool g = opts.gray ?? False;
                img.shade(g, az, el);
                break;
            }
            case "wave": {
                float amp = requireFloat("amplitude", opts.amplitude);
                float wl = requireFloat("wavelength", opts.wavelength);
                img.wave(amp, wl);
                break;
            }
            case "swirl": {
                float deg = requireFloat("degrees", opts.degrees);
                img.swirl(deg);
                break;
            }
            case "implode": {
                float amt = requireFloat("amount", opts.amount);
                img.implode(amt);
                break;
            }
            case "posterize": {
                int lvl = requireInt("levels", opts.levels);
                bool d = opts.dither ?? False;
                img.posterize(lvl, d);
                break;
            }
            case "threshold": {
                float t = requireFloat("threshold", opts.threshold);
                img.threshold(t);
                break;
            }
            case "blue-shift": {
                float f = opts.factor ?? 1.5;
                img.blueShift(f);
                break;
            }
            default:
                printf("%s unknown effect method %y\n", color.error("ERROR:"), method);
                printf("  Valid methods: %s\n", color.value("charcoal, edge, emboss, oil-paint, "
                    "sketch, solarize, sepia, vignette, shadow, shade, wave, swirl, implode, "
                    "posterize, threshold, blue-shift"));
                exit(1);
        }

        writeOutput(img, path);
    }

    private doNoise() {
        string path = requireArg("<input>");
        requireOutput();
        MagickImage img = readInput(path);

        string method = opts.method ?? "add";

        switch (method) {
            case "add": {
                string nt = opts.noise_type ?? "gaussian";
                float att = opts.attenuate ?? 1.0;
                img.addNoise(nt, att);
                break;
            }
            case "despeckle":
                img.despeckle();
                break;
            case "reduce": {
                float r = requireFloat("radius", opts.radius);
                img.reduceNoise(r);
                break;
            }
            case "wavelet-denoise": {
                float t = requireFloat("threshold", opts.threshold);
                float s = opts.softness ?? 0.0;
                img.waveletDenoise(t, s);
                break;
            }
            default:
                printf("%s unknown noise method %y\n", color.error("ERROR:"), method);
                printf("  Valid methods: %s\n",
                    color.value("add, despeckle, reduce, wavelet-denoise"));
                exit(1);
        }

        writeOutput(img, path);
    }

    private doComposite() {
        string path = requireArg("<base>");
        requireOutput();
        MagickImage img = readInput(path);

        string overlay_path = requireString("overlay", opts.overlay);
        MagickImage overlay = readInput(overlay_path);
        string comp_op = opts.op ?? "over";

        string method = opts.method ?? "overlay";

        switch (method) {
            case "overlay": {
                int cx = opts.x ?? 0;
                int cy = opts.y ?? 0;
                img.composite(overlay, comp_op, cx, cy);
                break;
            }
            case "gravity": {
                string grav = requireString("gravity", opts.gravity);
                img.compositeGravity(overlay, comp_op, grav);
                break;
            }
            default:
                printf("%s unknown composite method %y\n", color.error("ERROR:"), method);
                printf("  Valid methods: %s\n", color.value("overlay, gravity"));
                exit(1);
        }

        writeOutput(img, path);
    }

    private doAnnotate() {
        string path = requireArg("<input>");
        requireOutput();
        MagickImage img = readInput(path);

        string text = requireString("text", opts.text);
        float ax = float(opts.x ?? 0);
        float ay = float(opts.y ?? 0);
        float a_angle = opts.angle ?? 0.0;
        string a_font = opts.font ?? "";
        float a_size = opts.font_size ?? 0.0;
        string a_fill = opts.fill ?? "black";
        string a_stroke = opts.stroke ?? "";

        img.annotate(text, ax, ay, a_angle, a_font, a_size, a_fill, a_stroke);

        writeOutput(img, path);
    }

    private doDraw() {
        string path = requireArg("<input>");
        requireOutput();
        MagickImage img = readInput(path);

        list<hash<auto>> commands = loadCommands();

        MagickDrawing drawing();
        int cmd_idx = 0;
        foreach hash<auto> cmd in (commands) {
            *string op = cmd.op;
            if (!op) {
                printf("%s draw command %d missing %s key: %y\n", color.error("ERROR:"),
                    cmd_idx, color.key("op"), cmd);
                exit(1);
            }
            try {
                executeDrawOp(drawing, op, cmd);
            } catch (hash<ExceptionInfo> ex) {
                printf("%s draw command %d (%s) failed: %s\n", color.error("ERROR:"),
                    cmd_idx, color.key(op), ex.desc);
                exit(1);
            }
            ++cmd_idx;
        }

        img.draw(drawing);
        writeOutput(img, path);

        if ((opts.verbose ?? 0) > 0) {
            printf("%s %s draw operation%s applied\n", color.success("OK:"),
                color.number(sprintf("%d", commands.size())),
                commands.size() == 1 ? "" : "s");
        }
    }

    private executeDrawOp(MagickDrawing drawing, string op, hash<auto> cmd) {
        switch (op) {
            # ── Style operations ──
            case "set_fill_color":
                drawing.setFillColor(string(cmd.color));
                break;
            case "set_stroke_color":
                drawing.setStrokeColor(string(cmd.color));
                break;
            case "set_stroke_width":
                drawing.setStrokeWidth(float(cmd.width));
                break;
            case "set_fill_opacity":
                drawing.setFillOpacity(float(cmd.opacity));
                break;
            case "set_stroke_opacity":
                drawing.setStrokeOpacity(float(cmd.opacity));
                break;
            case "set_font":
                drawing.setFont(string(cmd.font));
                break;
            case "set_font_size":
                drawing.setFontSize(float(cmd.size));
                break;
            case "set_font_family":
                drawing.setFontFamily(string(cmd.family));
                break;
            case "set_font_weight":
                drawing.setFontWeight(int(cmd.weight));
                break;
            case "set_font_style":
                drawing.setFontStyle(string(cmd.style));
                break;

            # ── Shape operations ──
            case "line":
                drawing.line(float(cmd.sx), float(cmd.sy), float(cmd.ex), float(cmd.ey));
                break;
            case "rectangle":
                drawing.rectangle(float(cmd.x1), float(cmd.y1), float(cmd.x2), float(cmd.y2));
                break;
            case "round_rectangle":
                drawing.roundRectangle(float(cmd.x1), float(cmd.y1), float(cmd.x2), float(cmd.y2),
                    float(cmd.rx), float(cmd.ry));
                break;
            case "circle":
                drawing.circle(float(cmd.ox), float(cmd.oy), float(cmd.px), float(cmd.py));
                break;
            case "ellipse":
                drawing.ellipse(float(cmd.ox), float(cmd.oy), float(cmd.rx), float(cmd.ry),
                    float(cmd.start), float(cmd.end));
                break;
            case "arc":
                drawing.arc(float(cmd.sx), float(cmd.sy), float(cmd.ex), float(cmd.ey),
                    float(cmd.sd), float(cmd.ed));
                break;
            case "point":
                drawing.point(float(cmd.x), float(cmd.y));
                break;
            case "polygon":
                drawing.polygon(convertPoints(cmd.points));
                break;
            case "polyline":
                drawing.polyline(convertPoints(cmd.points));
                break;

            # ── Text ──
            case "text":
                drawing.annotation(float(cmd.x), float(cmd.y), string(cmd.text));
                break;

            # ── Transforms ──
            case "rotate":
                drawing.rotate(float(cmd.degrees));
                break;
            case "translate":
                drawing.translate(float(cmd.x), float(cmd.y));
                break;
            case "scale":
                drawing.drawScale(float(cmd.x), float(cmd.y));
                break;
            case "skew_x":
                drawing.skewX(float(cmd.degrees));
                break;
            case "skew_y":
                drawing.skewY(float(cmd.degrees));
                break;

            # ── State ──
            case "push":
                drawing.push();
                break;
            case "pop":
                drawing.pop();
                break;

            default:
                printf("%s unknown draw operation %y\n", color.error("ERROR:"), op);
                exit(1);
        }
    }

    private list<hash<PointInfo>> convertPoints(auto raw_points) {
        list<hash<PointInfo>> result();
        foreach auto pt in (raw_points) {
            push result, <PointInfo>{"x": float(pt.x), "y": float(pt.y)};
        }
        return result;
    }

    # ── Command Loading (YAML/JSON) ──────────────────────────────────────

    private list<hash<auto>> loadCommands() {
        *string input_str;
        bool use_yaml = False;

        if (opts.commands_file) {
            if (opts.commands_file == "-") {
                input_str = stdin.read(-1);
            } else {
                try {
                    input_str = ReadOnlyFile::readTextFile(opts.commands_file);
                } catch (hash<ExceptionInfo> ex) {
                    printf("%s failed to read %y: %s\n", color.error("ERROR:"),
                        opts.commands_file, ex.desc);
                    exit(1);
                }
                if (opts.commands_file =~ /\.ya?ml$/i) {
                    use_yaml = True;
                }
            }
        } else if (opts.commands) {
            input_str = opts.commands;
        } else if (!TerminalColor::isTerminal()) {
            input_str = stdin.read(-1);
        } else {
            printf("%s draw commands required; use %s, %s, or pipe to stdin\n",
                color.error("ERROR:"),
                color.key("--commands-file <file>"), color.key("--commands <yaml/json>"));
            exit(1);
        }
        if (!input_str) {
            printf("%s no draw commands received\n", color.error("ERROR:"));
            exit(1);
        }

        auto parsed = parseData(input_str, use_yaml);

        if (parsed.typeCode() == NT_LIST) {
            return parsed;
        }
        if (parsed.typeCode() == NT_HASH && parsed.commands) {
            return parsed.commands;
        }
        printf("%s invalid draw commands: expected a list or object with %s key\n",
            color.error("ERROR:"), color.key("commands"));
        exit(1);
    }

    private auto parseData(string input_str, bool prefer_yaml) {
        if (prefer_yaml) {
%ifdef NoYaml
            printf("%s YAML module required for .yaml/.yml files but is not available\n",
                color.error("ERROR:"));
            exit(1);
%else
            try {
                return parse_yaml(input_str);
            } catch (hash<ExceptionInfo> ex) {
                printf("%s invalid YAML: %s\n", color.error("ERROR:"), ex.desc);
                exit(1);
            }
%endif
        }

%ifndef NoYaml
        try {
            return parse_yaml(input_str);
        } catch () {
            # fall through to JSON
        }
%endif

%ifndef NoJson
        try {
            return parse_json(input_str);
        } catch (hash<ExceptionInfo> ex) {
%ifdef NoYaml
            printf("%s invalid JSON: %s\n", color.error("ERROR:"), ex.desc);
%else
            printf("%s failed to parse as YAML or JSON: %s\n", color.error("ERROR:"), ex.desc);
%endif
            exit(1);
        }
%endif

%ifdef NoYaml
%ifdef NoJson
        printf("%s neither YAML nor JSON modules are available\n", color.error("ERROR:"));
        exit(1);
%endif
%endif
    }

    # ── Border/Frame ─────────────────────────────────────────────────────

    private doBorder() {
        string path = requireArg("<input>");
        requireOutput();
        MagickImage img = readInput(path);

        string method = opts.method ?? "border";

        switch (method) {
            case "border": {
                string bc = opts.bcolor ?? "black";
                int w = requireInt("width", opts.width);
                int h = requireInt("height", opts.height);
                img.border(bc, w, h);
                break;
            }
            case "frame": {
                string bc = opts.bcolor ?? "black";
                int w = requireInt("width", opts.width);
                int h = requireInt("height", opts.height);
                int ib = requireInt("inner-bevel", opts.inner_bevel);
                int ob = requireInt("outer-bevel", opts.outer_bevel);
                img.frame(bc, w, h, ib, ob);
                break;
            }
            default:
                printf("%s unknown border method %y\n", color.error("ERROR:"), method);
                printf("  Valid methods: %s\n", color.value("border, frame"));
                exit(1);
        }

        writeOutput(img, path);
    }

    private doStrip() {
        string path = requireArg("<input>");
        requireOutput();
        MagickImage img = readInput(path);
        img.strip();
        writeOutput(img, path);
    }
}
