// --- Composite Methods ---

//! Composites another image onto this image at the specified position
/** @param source the source image to composite
    @param composite_operator the composite operator (e.g. "Over", "Multiply", "Screen")
    @param x the horizontal offset
    @param y the vertical offset

    @throw IMAGEMAGICK-ERROR error compositing the image
*/
nothing MagickImage::composite(MagickImage[QoreMagickImage] source, string composite_operator, int x, int y)
        [flags=NAMED_ARGS] {
    img->composite(*source, composite_operator->c_str(), x, y, xsink);
}

//! Composites another image using gravity-based positioning
/** @param source the source image to composite
    @param composite_operator the composite operator
    @param gravity the gravity type (e.g. "Center", "NorthWest")

    @throw IMAGEMAGICK-ERROR error compositing the image
*/
nothing MagickImage::compositeGravity(MagickImage[QoreMagickImage] source, string composite_operator,
        string gravity) [flags=NAMED_ARGS] {
    img->compositeGravity(*source, composite_operator->c_str(), gravity->c_str(), xsink);
}

// --- Drawing Methods ---

//! Annotates the image with text
/** @param text the text to draw
    @param x the horizontal position
    @param y the vertical position
    @param angle the text rotation angle in degrees
    @param font the font name or path (empty for default)
    @param font_size the font size in points (0 for default)
    @param fill_color the text fill color (empty for default)
    @param stroke_color the text stroke color (empty for none)

    @throw IMAGEMAGICK-ERROR error annotating the image
*/
nothing MagickImage::annotate(string text, float x, float y, float angle = 0.0,
                              string font = "", float font_size = 0.0,
                              string fill_color = "black", string stroke_color = "") [flags=NAMED_ARGS] {
    img->annotate(text->c_str(), x, y, angle, font->c_str(), font_size,
                  fill_color->c_str(), stroke_color->c_str(), xsink);
}

//! Draws vector graphics from a MagickDrawing object onto the image
/** @param drawing the MagickDrawing object with drawing commands

    @throw IMAGEMAGICK-ERROR error drawing on the image
*/
nothing MagickImage::draw(MagickDrawing[QoreMagickDrawing] drawing) [flags=NAMED_ARGS] {
    img->draw(drawing->getWand(), xsink);
}

//! Adds a border around the image
/** @param color the border color
    @param width the horizontal border width
    @param height the vertical border height

    @throw IMAGEMAGICK-ERROR error adding the border
*/
nothing MagickImage::border(string color, int width, int height) [flags=NAMED_ARGS] {
    img->border(color->c_str(), width, height, xsink);
}

//! Adds a decorative frame around the image
/** @param color the frame color
    @param width the frame width
    @param height the frame height
    @param inner_bevel the inner bevel width
    @param outer_bevel the outer bevel width

    @throw IMAGEMAGICK-ERROR error adding the frame
*/
nothing MagickImage::frame(string color, int width, int height, int inner_bevel, int outer_bevel) [flags=NAMED_ARGS] {
    img->frame(color->c_str(), width, height, inner_bevel, outer_bevel, xsink);
}

// --- Multi-image Methods ---

//! Checks if there is a next image in the image list
/** @return True if there is a next image
*/
