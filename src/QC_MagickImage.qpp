#include "QC_MagickImage.h"
#include "QoreMagickImage.h"
#include "QC_MagickDrawing.h"
#include "QoreMagickDrawing.h"

/** @defgroup im_filter_types ImageMagick Filter Types
    These constants define the filter types for image resizing.
*/
///@{
//! Lanczos filter (high quality, recommended for most uses)
const IM_FILTER_LANCZOS = IM_FILTER_LANCZOS_VAL;

//! Mitchell filter (balanced sharpness and ringing)
const IM_FILTER_MITCHELL = IM_FILTER_MITCHELL_VAL;

//! Catrom filter (Catmull-Rom, good for reduction)
const IM_FILTER_CATROM = IM_FILTER_CATROM_VAL;

//! Gaussian filter
const IM_FILTER_GAUSSIAN = IM_FILTER_GAUSSIAN_VAL;

//! Box filter (nearest neighbor for upscale)
const IM_FILTER_BOX = IM_FILTER_BOX_VAL;

//! Triangle (bilinear) filter
const IM_FILTER_TRIANGLE = IM_FILTER_TRIANGLE_VAL;

//! Point filter (nearest neighbor)
const IM_FILTER_POINT = IM_FILTER_POINT_VAL;

//! Cubic filter
const IM_FILTER_CUBIC = IM_FILTER_CUBIC_VAL;
///@}

/** @defgroup im_colorspace_types ImageMagick Colorspace Types
    String constants for colorspace types used with MagickImage methods.
*/
///@{
//! sRGB colorspace
const IM_COLORSPACE_SRGB = "sRGB";

//! RGB colorspace
const IM_COLORSPACE_RGB = "RGB";

//! CMYK colorspace
const IM_COLORSPACE_CMYK = "CMYK";

//! Grayscale colorspace
const IM_COLORSPACE_GRAY = "Gray";

//! HSL colorspace
const IM_COLORSPACE_HSL = "HSL";

//! Lab colorspace
const IM_COLORSPACE_LAB = "Lab";
///@}

/** @defgroup im_composite_ops ImageMagick Composite Operators
    String constants for composite operations.
*/
///@{
//! Overlay source on destination
const IM_COMPOSITE_OVER = "Over";

//! Multiply composite
const IM_COMPOSITE_MULTIPLY = "Multiply";

//! Screen composite
const IM_COMPOSITE_SCREEN = "Screen";

//! Overlay composite
const IM_COMPOSITE_OVERLAY = "Overlay";

//! Difference composite
const IM_COMPOSITE_DIFFERENCE = "Difference";

//! Addition composite
const IM_COMPOSITE_PLUS = "Plus";

//! Dissolve composite
const IM_COMPOSITE_DISSOLVE = "Dissolve";
///@}

/** @defgroup im_gravity_types ImageMagick Gravity Types
    String constants for gravity types.
*/
///@{
//! Center gravity
const IM_GRAVITY_CENTER = "Center";

//! North gravity
const IM_GRAVITY_NORTH = "North";

//! South gravity
const IM_GRAVITY_SOUTH = "South";

//! East gravity
const IM_GRAVITY_EAST = "East";

//! West gravity
const IM_GRAVITY_WEST = "West";

//! NorthWest gravity
const IM_GRAVITY_NORTHWEST = "NorthWest";

//! NorthEast gravity
const IM_GRAVITY_NORTHEAST = "NorthEast";

//! SouthWest gravity
const IM_GRAVITY_SOUTHWEST = "SouthWest";

//! SouthEast gravity
const IM_GRAVITY_SOUTHEAST = "SouthEast";
///@}

/** @defgroup im_noise_types ImageMagick Noise Types
    String constants for noise types.
*/
///@{
//! Uniform noise
const IM_NOISE_UNIFORM = "Uniform";

//! Gaussian noise
const IM_NOISE_GAUSSIAN = "Gaussian";

//! Multiplicative Gaussian noise
const IM_NOISE_MULTIPLICATIVE_GAUSSIAN = "MultiplicativeGaussian";

//! Impulse noise
const IM_NOISE_IMPULSE = "Impulse";

//! Laplacian noise
const IM_NOISE_LAPLACIAN = "Laplacian";

//! Poisson noise
const IM_NOISE_POISSON = "Poisson";

//! Random noise
const IM_NOISE_RANDOM = "Random";
///@}

//! Image metadata information
/** @since %imagemagick 1.0
*/
hashdecl Qore::ImageMagick::ImageInfo {
    //! Image width in pixels
    int width;

    //! Image height in pixels
    int height;

    //! Image format (e.g. "PNG", "JPEG", "GIF")
    string format;

    //! Image depth in bits per channel
    int depth;

    //! Image colorspace (e.g. "sRGB", "CMYK", "Gray")
    string colorspace;

    //! Image type (e.g. "TrueColor", "Palette", "Grayscale")
    string image_type;

    //! Image resolution
    hash<ImageResolutionInfo> resolution;

    //! Compression quality (0-100, format dependent)
    int compression_quality;

    //! Number of images (for multi-image formats like GIF)
    int number_images;

    //! Number of unique colors in the image
    int colors;

    //! Cryptographic signature of the image
    string signature;
}

//! Image resolution information
/** @since %imagemagick 1.0
*/
hashdecl Qore::ImageMagick::ImageResolutionInfo {
    //! Horizontal resolution (DPI)
    float x;

    //! Vertical resolution (DPI)
    float y;
}

//! Point coordinates for drawing operations
/** @since %imagemagick 1.0
*/
hashdecl Qore::ImageMagick::PointInfo {
    //! X coordinate
    float x;

    //! Y coordinate
    float y;
}

//! The MagickImage class provides comprehensive image processing and manipulation capabilities
/**
    @par Example: Loading and resizing an image
    @code{.py}
#!/usr/bin/qore

%requires imagemagick

MagickImage img("photo.jpg");
img.resize(800, 600, "Lanczos");
img.writeFile("photo_resized.jpg");
    @endcode

    @par Example: Creating a thumbnail with effects
    @code{.py}
MagickImage img("photo.jpg");
img.thumbnail(200, 200);
img.sharpen(0.0, 1.0);
img.setCompressionQuality(85);
img.writeFile("thumb.jpg");
    @endcode

    @par Example: Format conversion
    @code{.py}
MagickImage img("document.png");
binary jpeg_data = img.toData("JPEG");
    @endcode

    @par Example: Working with image metadata
    @code{.py}
MagickImage img("photo.jpg");
hash<ImageInfo> info = img.getInfo();
printf("Size: %dx%d, Format: %s\n", info.width, info.height, info.format);
*string exif_date = img.getProperty("exif:DateTimeOriginal");
    @endcode

    @since %imagemagick 1.0
*/
qclass MagickImage [arg=QoreMagickImage* img; ns=Qore::ImageMagick];

//! Creates a MagickImage by reading from a file
/** @param path the path to the image file

    @throw IMAGEMAGICK-ERROR error reading the image file
*/
MagickImage::constructor(string path) [dom=FILESYSTEM;flags=NAMED_ARGS] {
    ReferenceHolder<QoreMagickImage> holder(new QoreMagickImage(path->c_str(), xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_MAGICKIMAGE, holder.release());
}

//! Creates a MagickImage from binary data
/** @param data binary data containing an image

    @throw IMAGEMAGICK-ERROR error reading the image data
*/
MagickImage::constructor(binary data) [flags=NAMED_ARGS] {
    ReferenceHolder<QoreMagickImage> holder(new QoreMagickImage(data, xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_MAGICKIMAGE, holder.release());
}

//! Creates a MagickImage from binary data with an explicit format
/** @param data binary data containing an image
    @param format the image format (e.g. "PNG", "JPEG")

    @throw IMAGEMAGICK-ERROR error reading the image data
*/
MagickImage::constructor(binary data, string format) [flags=NAMED_ARGS] {
    ReferenceHolder<QoreMagickImage> holder(new QoreMagickImage(data, format->c_str(), xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_MAGICKIMAGE, holder.release());
}

//! Creates a blank image with the given dimensions and background color
/** @param width the image width in pixels
    @param height the image height in pixels
    @param background_color the background color name (e.g. "white", "black", "#FF0000", "transparent")

    @throw IMAGEMAGICK-ERROR error creating the image
*/
MagickImage::constructor(int width, int height, string background_color = "white") [flags=NAMED_ARGS] {
    ReferenceHolder<QoreMagickImage> holder(
        new QoreMagickImage(static_cast<size_t>(width), static_cast<size_t>(height),
                            background_color->c_str(), xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_MAGICKIMAGE, holder.release());
}

//! Creates a copy of this MagickImage
/** @return a new independent MagickImage copy

    @throw IMAGEMAGICK-ERROR error cloning the image
*/
MagickImage::copy() {
    ReferenceHolder<QoreMagickImage> holder(new QoreMagickImage(*img, xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_MAGICKIMAGE, holder.release());
}

//! Destroys the MagickImage object
/**
*/
MagickImage::destructor() {
    img->deref(xsink);
}

// --- I/O Methods ---

//! Reads an image from a file, appending to the image list
/** @param path the path to the image file

    @throw IMAGEMAGICK-ERROR error reading the image file
*/
nothing MagickImage::readFile(string path) [dom=FILESYSTEM;flags=NAMED_ARGS] {
    img->readFile(path->c_str(), xsink);
}

//! Reads an image from binary data, appending to the image list
/** @param data binary data containing an image

    @throw IMAGEMAGICK-ERROR error reading the image data
*/
nothing MagickImage::readData(binary data) [flags=NAMED_ARGS] {
    img->readData(data, xsink);
}

//! Gets image metadata from a file without reading pixel data
/** @param path the path to the image file

    @return an @ref Qore::ImageMagick::ImageInfo hash with image metadata

    @throw IMAGEMAGICK-ERROR error pinging the image file
*/
hash<ImageInfo> MagickImage::pingFile(string path) [dom=FILESYSTEM;flags=NAMED_ARGS] {
    return img->pingFile(path->c_str(), xsink);
}

//! Gets image metadata from binary data without decoding pixel data
/** @param data binary data containing an image

    @return an @ref Qore::ImageMagick::ImageInfo hash with image metadata

    @throw IMAGEMAGICK-ERROR error pinging the image data
*/
hash<ImageInfo> MagickImage::pingData(binary data) [flags=NAMED_ARGS] {
    return img->pingData(data, xsink);
}

//! Writes the image to a file
/** @param path the output file path; the format is determined by the file extension

    @throw IMAGEMAGICK-ERROR error writing the image file
*/
nothing MagickImage::writeFile(string path) [dom=FILESYSTEM;flags=NAMED_ARGS] {
    img->writeFile(path->c_str(), xsink);
}

//! Writes all images in the list to a file
/** @param path the output file path
    @param adjoin if True, join all images into a single multi-image file

    @throw IMAGEMAGICK-ERROR error writing the image files
*/
nothing MagickImage::writeFiles(string path, bool adjoin = True) [dom=FILESYSTEM;flags=NAMED_ARGS] {
    img->writeFiles(path->c_str(), adjoin, xsink);
}

//! Returns the image as binary data in its current format
/** @return the image data as binary

    @throw IMAGEMAGICK-ERROR error getting the image data
*/
binary MagickImage::toData() {
    return img->toData(xsink);
}

//! Returns the image as binary data in the specified format
/** @param format the output format (e.g. "PNG", "JPEG", "GIF", "BMP", "TIFF")

    @return the image data as binary in the specified format

    @throw IMAGEMAGICK-ERROR error getting the image data
*/
binary MagickImage::toData(string format) [flags=NAMED_ARGS] {
    return img->toDataWithFormat(format->c_str(), xsink);
}

// --- Info/Metadata Methods ---

//! Returns the image width in pixels
/** @return the width
*/
int MagickImage::width() {
    return img->getWidth(xsink);
}

//! Returns the image height in pixels
/** @return the height
*/
int MagickImage::height() {
    return img->getHeight(xsink);
}

//! Returns the image format
/** @return the format string (e.g. "PNG", "JPEG")
*/
string MagickImage::format() {
    return img->getFormat(xsink);
}

//! Sets the image format
/** @param format the format string (e.g. "PNG", "JPEG")

    @throw IMAGEMAGICK-ERROR error setting the format
*/
nothing MagickImage::setFormat(string format) [flags=NAMED_ARGS] {
    img->setFormat(format->c_str(), xsink);
}

//! Returns the image depth (bits per channel)
/** @return the depth
*/
int MagickImage::depth() {
    return img->getDepth(xsink);
}

//! Sets the image depth
/** @param depth bits per channel

    @throw IMAGEMAGICK-ERROR error setting the depth
*/
nothing MagickImage::setDepth(int depth) [flags=NAMED_ARGS] {
    img->setDepth(depth, xsink);
}

//! Returns the image colorspace
/** @return the colorspace name (e.g. "sRGB", "CMYK", "Gray")
*/
string MagickImage::colorspace() {
    return img->getColorspace(xsink);
}

//! Sets the image colorspace
/** @param colorspace the colorspace name

    @throw IMAGEMAGICK-ERROR error setting the colorspace
*/
nothing MagickImage::setColorspace(string colorspace) [flags=NAMED_ARGS] {
    img->setColorspace(colorspace->c_str(), xsink);
}

//! Returns the image type
/** @return the image type (e.g. "TrueColor", "Grayscale", "Palette")
*/
string MagickImage::imageType() {
    return img->getImageType(xsink);
}

//! Returns the image resolution
/** @return an @ref Qore::ImageMagick::ImageResolutionInfo hash
*/
hash<ImageResolutionInfo> MagickImage::resolution() {
    return img->getResolution(xsink);
}

//! Sets the image resolution
/** @param x_resolution horizontal resolution (DPI)
    @param y_resolution vertical resolution (DPI)

    @throw IMAGEMAGICK-ERROR error setting the resolution
*/
nothing MagickImage::setResolution(float x_resolution, float y_resolution) [flags=NAMED_ARGS] {
    img->setResolution(x_resolution, y_resolution, xsink);
}

//! Returns the compression quality
/** @return the quality value (0-100)
*/
int MagickImage::compressionQuality() {
    return img->getCompressionQuality(xsink);
}

//! Sets the compression quality
/** @param quality the quality value (0-100, format dependent)

    @throw IMAGEMAGICK-ERROR error setting the quality
*/
nothing MagickImage::setCompressionQuality(int quality) [flags=NAMED_ARGS] {
    img->setCompressionQuality(quality, xsink);
}

//! Returns the image signature (cryptographic hash)
/** @return the signature string
*/
string MagickImage::signature() {
    return img->getSignature(xsink);
}

//! Returns a verbose description of the image
/** @return a string with detailed image information
*/
string MagickImage::identify() {
    return img->identify(xsink);
}

//! Returns the number of unique colors
/** @return the color count
*/
int MagickImage::colors() {
    return img->getColors(xsink);
}

//! Returns the number of images in the image list
/** @return the image count
*/
int MagickImage::numberImages() {
    return img->getNumberImages(xsink);
}

//! Returns comprehensive image metadata
/** @return an @ref Qore::ImageMagick::ImageInfo hash
*/
hash<ImageInfo> MagickImage::getInfo() {
    return img->getInfo(xsink);
}

// --- Properties/Profiles ---

//! Gets an image property value
/** @param name the property name (e.g. "exif:DateTimeOriginal", "comment")

    @return the property value, or NOTHING if not found
*/
*string MagickImage::getProperty(string name) [flags=NAMED_ARGS] {
    return img->getProperty(name->c_str(), xsink);
}

//! Gets all image properties matching a pattern
/** @param pattern the property name pattern (e.g. "exif:*", "*")

    @return a hash of property name/value pairs
*/
hash<auto> MagickImage::getProperties(string pattern = "*") [flags=NAMED_ARGS] {
    return img->getProperties(pattern->c_str(), xsink);
}

//! Sets an image property
/** @param name the property name
    @param value the property value

    @throw IMAGEMAGICK-ERROR error setting the property
*/
nothing MagickImage::setProperty(string name, string value) [flags=NAMED_ARGS] {
    img->setProperty(name->c_str(), value->c_str(), xsink);
}

//! Deletes an image property
/** @param name the property name

    @throw IMAGEMAGICK-ERROR error deleting the property
*/
nothing MagickImage::deleteProperty(string name) [flags=NAMED_ARGS] {
    img->deleteProperty(name->c_str(), xsink);
}

//! Gets an image profile (e.g. ICC, IPTC, EXIF)
/** @param name the profile name (e.g. "icc", "iptc", "exif")

    @return the profile data as binary, or NOTHING if not found
*/
*binary MagickImage::getProfile(string name) [flags=NAMED_ARGS] {
    return img->getProfile(name->c_str(), xsink);
}

//! Sets an image profile
/** @param name the profile name
    @param data the profile data

    @throw IMAGEMAGICK-ERROR error setting the profile
*/
nothing MagickImage::setProfile(string name, binary data) [flags=NAMED_ARGS] {
    img->setProfile(name->c_str(), data, xsink);
}

//! Gets the names of all image profiles
/** @return a list of profile names
*/
list<string> MagickImage::getProfileNames() {
    return img->getProfileNames(xsink);
}

//! Strips all profiles and comments from the image
/** @throw IMAGEMAGICK-ERROR error stripping the image
*/
nothing MagickImage::strip() {
    img->strip(xsink);
}

// --- Resize Methods ---

//! Resizes the image using the specified filter
/** @param width the target width
    @param height the target height
    @param filter the filter type name (e.g. "Lanczos", "Mitchell", "Catrom")

    @throw IMAGEMAGICK-ERROR error resizing the image
*/
nothing MagickImage::resize(int width, int height, string filter = "Lanczos") [flags=NAMED_ARGS] {
    img->resize(width, height, filter->c_str(), xsink);
}

//! Scales the image (fast, no filtering)
/** @param width the target width
    @param height the target height

    @throw IMAGEMAGICK-ERROR error scaling the image
*/
nothing MagickImage::scale(int width, int height) [flags=NAMED_ARGS] {
    img->scale(width, height, xsink);
}

//! Creates a thumbnail of the image
/** @param width the target width
    @param height the target height

    @throw IMAGEMAGICK-ERROR error creating the thumbnail
*/
nothing MagickImage::thumbnail(int width, int height) [flags=NAMED_ARGS] {
    img->thumbnail(width, height, xsink);
}

//! Adaptively resizes the image with data-dependent triangulation
/** @param width the target width
    @param height the target height

    @throw IMAGEMAGICK-ERROR error resizing the image
*/
nothing MagickImage::adaptiveResize(int width, int height) [flags=NAMED_ARGS] {
    img->adaptiveResize(width, height, xsink);
}

//! Scales the image using pixel sampling (fastest, no interpolation)
/** @param width the target width
    @param height the target height

    @throw IMAGEMAGICK-ERROR error sampling the image
*/
nothing MagickImage::sample(int width, int height) [flags=NAMED_ARGS] {
    img->sample(width, height, xsink);
}

//! Resamples the image to the given resolution
/** @param x_resolution the target horizontal resolution (DPI)
    @param y_resolution the target vertical resolution (DPI)
    @param filter the filter type name

    @throw IMAGEMAGICK-ERROR error resampling the image
*/
nothing MagickImage::resample(float x_resolution, float y_resolution, string filter = "Lanczos") [flags=NAMED_ARGS] {
    img->resample(x_resolution, y_resolution, filter->c_str(), xsink);
}

//! Rescales the image using liquid/content-aware rescaling
/** @param width the target width
    @param height the target height
    @param delta_x maximum seam step (0 = strict)
    @param rigidity introduces a bias for non-straight seams (0 = unbiased)

    @throw IMAGEMAGICK-ERROR error rescaling the image
*/
nothing MagickImage::liquidRescale(int width, int height, float delta_x = 0.0, float rigidity = 0.0) [flags=NAMED_ARGS] {
    img->liquidRescale(width, height, delta_x, rigidity, xsink);
}

// --- Crop Methods ---

//! Crops the image to the specified region
/** @param width the crop width
    @param height the crop height
    @param x the left offset
    @param y the top offset

    @throw IMAGEMAGICK-ERROR error cropping the image
*/
nothing MagickImage::crop(int width, int height, int x, int y) [flags=NAMED_ARGS] {
    img->crop(width, height, x, y, xsink);
}

//! Trims the image by removing edges that match the background
/** @param fuzz color tolerance for edge detection (0.0 = exact match)

    @throw IMAGEMAGICK-ERROR error trimming the image
*/
nothing MagickImage::trim(float fuzz = 0.0) [flags=NAMED_ARGS] {
    img->trim(fuzz, xsink);
}

//! Sets the image extent (canvas size and position)
/** @param width the new canvas width
    @param height the new canvas height
    @param x the horizontal offset of the image on the canvas
    @param y the vertical offset of the image on the canvas

    @throw IMAGEMAGICK-ERROR error setting the extent
*/
nothing MagickImage::extent(int width, int height, int x = 0, int y = 0) [flags=NAMED_ARGS] {
    img->extent(width, height, x, y, xsink);
}

//! Removes a region from the image
/** @param width the region width
    @param height the region height
    @param x the left offset
    @param y the top offset

    @throw IMAGEMAGICK-ERROR error chopping the image
*/
nothing MagickImage::chop(int width, int height, int x, int y) [flags=NAMED_ARGS] {
    img->chop(width, height, x, y, xsink);
}

//! Shaves pixels from the edges of the image
/** @param columns the number of columns to shave from each side
    @param rows the number of rows to shave from top and bottom

    @throw IMAGEMAGICK-ERROR error shaving the image
*/
nothing MagickImage::shave(int columns, int rows) [flags=NAMED_ARGS] {
    img->shave(columns, rows, xsink);
}

//! Splices a region of the image
/** @param width the width of the splice region
    @param height the height of the splice region
    @param x the left offset
    @param y the top offset

    @throw IMAGEMAGICK-ERROR error splicing the image
*/
nothing MagickImage::splice(int width, int height, int x, int y) [flags=NAMED_ARGS] {
    img->splice(width, height, x, y, xsink);
}

// --- Transform Methods ---

//! Rotates the image by the given angle
/** @param degrees the rotation angle in degrees (clockwise)
    @param background_color the background color for areas exposed by rotation

    @throw IMAGEMAGICK-ERROR error rotating the image
*/
nothing MagickImage::rotate(float degrees, string background_color = "white") [flags=NAMED_ARGS] {
    img->rotate(degrees, background_color->c_str(), xsink);
}

//! Flips the image vertically (top to bottom mirror)
/** @throw IMAGEMAGICK-ERROR error flipping the image
*/
nothing MagickImage::flip() {
    img->flip(xsink);
}

//! Flops the image horizontally (left to right mirror)
/** @throw IMAGEMAGICK-ERROR error flopping the image
*/
nothing MagickImage::flop() {
    img->flop(xsink);
}

//! Transposes the image (mirror along top-left to bottom-right diagonal)
/** @throw IMAGEMAGICK-ERROR error transposing the image
*/
nothing MagickImage::transpose() {
    img->transpose(xsink);
}

//! Transverses the image (mirror along top-right to bottom-left diagonal)
/** @throw IMAGEMAGICK-ERROR error transversing the image
*/
nothing MagickImage::transverse() {
    img->transverse(xsink);
}

//! Shears the image
/** @param x_shear the horizontal shear angle in degrees
    @param y_shear the vertical shear angle in degrees
    @param background_color the background color for exposed areas

    @throw IMAGEMAGICK-ERROR error shearing the image
*/
nothing MagickImage::shear(float x_shear, float y_shear, string background_color = "white") [flags=NAMED_ARGS] {
    img->shear(x_shear, y_shear, background_color->c_str(), xsink);
}

//! Straightens the image by removing skew
/** @param threshold the deskew threshold (try 40%% of quantum range)

    @throw IMAGEMAGICK-ERROR error deskewing the image
*/
nothing MagickImage::deskew(float threshold) [flags=NAMED_ARGS] {
    img->deskew(threshold, xsink);
}

//! Automatically orients the image based on EXIF orientation tag
/** @throw IMAGEMAGICK-ERROR error auto-orienting the image
*/
nothing MagickImage::autoOrient() {
    img->autoOrient(xsink);
}

// --- Blur/Sharpen Methods ---

//! Applies a blur filter
/** @param radius the blur radius (0 for auto)
    @param sigma the blur standard deviation

    @throw IMAGEMAGICK-ERROR error blurring the image
*/
nothing MagickImage::blur(float radius, float sigma) [flags=NAMED_ARGS] {
    img->blur(radius, sigma, xsink);
}

//! Applies a Gaussian blur filter
/** @param radius the blur radius (0 for auto)
    @param sigma the blur standard deviation

    @throw IMAGEMAGICK-ERROR error blurring the image
*/
nothing MagickImage::gaussianBlur(float radius, float sigma) [flags=NAMED_ARGS] {
    img->gaussianBlur(radius, sigma, xsink);
}

//! Applies an adaptive blur that is stronger in less detailed areas
