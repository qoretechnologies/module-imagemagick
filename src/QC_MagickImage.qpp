    return img->hasNextImage(xsink);
}

//! Checks if there is a previous image in the image list
/** @return True if there is a previous image
*/
bool MagickImage::hasPreviousImage() {
    return img->hasPreviousImage(xsink);
}

//! Advances to the next image in the image list
/** @return True if successful
*/
bool MagickImage::nextImage() {
    return img->nextImage(xsink);
}

//! Goes back to the previous image in the image list
/** @return True if successful
*/
bool MagickImage::previousImage() {
    return img->previousImage(xsink);
}

//! Sets the iterator to a specific image index
/** @param index the image index (0-based)

    @throw IMAGEMAGICK-ERROR error setting the iterator
*/
nothing MagickImage::setIteratorIndex(int index) [flags=NAMED_ARGS] {
    img->setIteratorIndex(index, xsink);
}

//! Returns the current iterator index
/** @return the current index
*/
int MagickImage::iteratorIndex() {
    return img->getIteratorIndex(xsink);
}

//! Resets the iterator to the first image
/**
*/
nothing MagickImage::resetIterator() {
    img->resetIterator(xsink);
}

// --- Pixel Methods ---

//! Gets the color of a pixel
